#!/usr/bin/env python3
"""Makes the KrissOS sound theme's own sounds (theme/sounds/kriss/stereo/*.oga) with ffmpeg.

Each sound is a few soft mallet notes: a sine with a little second harmonic, a 5 ms
attack and an exponential fade. Tune the notes here and run it again; the .oga files are
committed so builds need no ffmpeg. Every other sound comes from Ocean (index.theme).
"""
import pathlib
import subprocess

# MIDI note numbers: 60 is middle C.
C5, D5, E5, G5, A5, B5, C6, E6, G6 = 72, 74, 76, 79, 81, 83, 84, 88, 91

# name: (notes as (start s, note), fade per second, length s, loudness)
SOUNDS = {
    "desktop-login": ([(0, C5), (0.12, E5), (0.24, G5), (0.36, C6)], 3.5, 1.6, 0.30),
    "desktop-logout": ([(0, C6), (0.12, G5), (0.24, E5), (0.36, C5)], 3.5, 1.6, 0.30),
    "message-new-instant": ([(0, G5), (0.11, D5 + 12)], 6, 0.8, 0.30),
    "dialog-warning": ([(0, A5), (0.16, A5)], 7, 0.7, 0.30),
    "audio-volume-change": ([(0, E6)], 40, 0.12, 0.25),
    "power-plug": ([(0, C5), (0.09, G5)], 8, 0.6, 0.28),
    "power-unplug": ([(0, G5), (0.09, C5)], 8, 0.6, 0.28),
    "device-added": ([(0, E5), (0.09, B5)], 8, 0.6, 0.28),
    "device-removed": ([(0, B5), (0.09, E5)], 8, 0.6, 0.28),
    "battery-low": ([(0, G5), (0.18, E5), (0.36, C5)], 4, 1.3, 0.32),
    "battery-caution": ([(0, G5), (0.18, E5), (0.36, C5), (0.8, G5), (0.98, E5), (1.16, C5)], 4, 2.1, 0.32),
}


def expr(notes, fade, loud):
    parts = []
    for start, note in notes:
        f = 440 * 2 ** ((note - 69) / 12)
        d = f"(t-{start})"
        parts.append(f"gte(t,{start})*min(1,{d}*200)*exp(-{d}*{fade})"
                     f"*(sin(2*PI*{f:.2f}*{d})+0.3*sin(4*PI*{f:.2f}*{d}))")
    return f"{loud}*({'+'.join(parts)})"


def main():
    out = pathlib.Path(__file__).with_name("kriss") / "stereo"
    out.mkdir(parents=True, exist_ok=True)
    for name, (notes, fade, length, loud) in SOUNDS.items():
        subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-f", "lavfi", "-i",
                        f"aevalsrc='{expr(notes, fade, loud)}':s=48000:d={length}",
                        "-ac", "2", "-c:a", "vorbis", "-strict", "-2", "-map_metadata", "-1",
                        "-fflags", "+bitexact", str(out / f"{name}.oga")], check=True)


if __name__ == "__main__":
    main()
