# KrissOS colour scheme for KDE Plasma. Generated from theme/tokens.json; do not edit.
# kriss-settings appends this file to /etc/xdg/kdeglobals so it is also the default.
[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={{surface.rgb}}
BackgroundNormal={{surface.rgb}}
DecorationFocus={{accent.rgb}}
DecorationHover={{accent.rgb}}
ForegroundActive={{accent.rgb}}
ForegroundInactive={{muted.rgb}}
ForegroundLink={{accent.rgb}}
ForegroundNegative={{color1.rgb}}
ForegroundNeutral={{color3.rgb}}
ForegroundNormal={{fg.rgb}}
ForegroundPositive={{color2.rgb}}
ForegroundVisited={{color5.rgb}}

