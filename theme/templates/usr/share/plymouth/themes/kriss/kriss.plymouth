[Plymouth Theme]
Name=KrissOS
Description=The keris emblem reveals on Obsidian black, then breathes until the system is up.
ModuleName=script
# The mkinitcpio hook copies this font into the initramfs for the password prompt.
Font={{font_sans}}

[script]
ImageDir=/usr/share/plymouth/themes/kriss
ScriptFile=/usr/share/plymouth/themes/kriss/kriss.script
