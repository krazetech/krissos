#!/usr/bin/env python3
"""Check that kriss-shell-toplevels still sees new windows after Python's garbage collector runs.

    shell/toplevels-check [COMMAND...]      default command: cosmic-term

Runs inside a cosmic-comp session (a nested one is fine): starts the helper's window list,
forces a full garbage collection, opens a window with COMMAND, and fails unless the window
shows up. pywayland holds its proxies only weakly, so a proxy the helper forgets to keep
(the wl_registry once) is freed by the collector and every later new window is lost.
Set KRISS_SHELL_LIB as for the helper when the bindings are not in /usr/lib/kriss-shell.
"""
import gc
import importlib.machinery
import importlib.util
import pathlib
import subprocess
import sys
import tempfile
import time

path = pathlib.Path(__file__).resolve().parent / "kriss-shell-toplevels"
loader = importlib.machinery.SourceFileLoader("toplevels", str(path))
helper = importlib.util.module_from_spec(importlib.util.spec_from_loader("toplevels", loader))
loader.exec_module(helper)
scratch = tempfile.TemporaryDirectory()
helper.THUMBS = scratch.name  # leave the running shell's preview pictures alone

with helper.Display() as display:
    tops = helper.Toplevels(display)
    tops.emit = lambda: None
    tops.start()
    display.roundtrip()
    before = set(tops.windows)
    gc.collect()
    app = subprocess.Popen(sys.argv[1:] or ["cosmic-term"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline and not set(tops.windows) - before:
            display.roundtrip()
            time.sleep(0.1)
    finally:
        app.terminate()
    new = set(tops.windows) - before
    print("toplevels-check:", "ok, saw the new window" if new else "FAILED: the new window never showed up")
    sys.exit(0 if new else 1)
