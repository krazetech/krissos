{
    HomeFolder: "cosmic-files",
    Launcher: "kriss-shell launcher",
    LockScreen: "kriss-shell lock",
    // Print Screen: the whole screen to ~/Pictures/Screenshots and the clipboard.
    Screenshot: "kriss-shell screenshot",
    // COSMIC's settings daemon normally supplies these; the KrissOS Shell runs without it.
    BrightnessDown: "kriss-shell brightness 5%-",
    BrightnessUp: "kriss-shell brightness 5%+",
    Mute: "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    MuteMic: "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    VolumeLower: "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-",
    VolumeRaise: "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    // COSMIC's defaults run cosmic-launcher and playerctl, which the KrissOS Shell doesn't use.
    WindowSwitcher: "kriss-shell switcher next",
    WindowSwitcherPrevious: "kriss-shell switcher previous",
    PlayPause: "kriss-shell media playPause",
    PlayNext: "kriss-shell media next",
    PlayPrev: "kriss-shell media previous",
}
