# KrissOS Shell.
#   kriss-shell            start a session: cosmic-comp with the shell inside it (SDDM runs this)
#   kriss-shell launcher   open or close the launcher (cosmic-comp runs this for the Windows key)
#   kriss-shell quick      open or close quick settings (Windows+A)
#   kriss-shell notifications
#                          open or close the notification center (Windows+N)
#   kriss-shell calendar   open or close the calendar under the clock (Windows+Alt+D)
#   kriss-shell widgets    open or close the widgets panel (Windows+W)
#   kriss-shell lock       lock the screen (Windows+L)
#   kriss-shell clipboard  open or close the clipboard history (Windows+V)
#   kriss-shell emoji      open or close the emoji and symbol picker (Windows+.)
#   kriss-shell greeter    the login screen, which greetd runs (see shell/README.md)
#   kriss-shell desktop    show the desktop, or bring the windows back (Windows+D)
#   kriss-shell taskbar focus|tray|startMenu|open N|newWindow N|jumpList N
#                          the taskbar keys: Windows+T, Windows+B, Windows+X, Windows+1…9,
#                          Windows+Shift+1…9 and Windows+Alt+1…9
#   kriss-shell taskview   open or close Task View (Windows+Tab)
#   kriss-shell desktops add|close
#                          a new desktop, or close the current one (Windows+Ctrl+D, Windows+Ctrl+F4)
#   kriss-shell personalise [colours|background|taskbar|pins|text]
#                          Settings, at that Personalise page
#   kriss-shell settings [PAGE]
#                          Settings, at a page (display, sound, wifi, datetime...)
#   kriss-shell project    Windows+P: PC screen only, Duplicate, Extend, Second screen only
#   kriss-shell snap       the snap layouts for the window in front (Windows+Z)
#   kriss-shell layout windows|mac
#                          the taskbar, or the Mac layout (top bar and dock); saved, live
#   kriss-shell input next|previous|osk
#                          the next input method, EN, 拼, த or ج (Windows+Space, Windows+Shift+Space),
#                          or show or hide the on-screen keyboard
#   kriss-shell switcher next|previous
#                          the Alt+Tab window switcher (Alt+Tab and Alt+Shift+Tab)
#   kriss-shell media playPause|next|previous
#                          the media keys, for the player playing (or the last one)
#   kriss-shell brightness STEP
#                          change the brightness and show the level (brightness keys, e.g. 5%+)
#   kriss-shell switch-user
#                          lock and show the login screen for someone else (Start's account menu)
#   kriss-shell screenshot [region|area]
#                          the whole screen (Print Screen) to ~/Pictures/Screenshots and the
#                          clipboard; region opens the snipping bar (Windows+Shift+S), area a
#                          dragged box straight away
#   kriss-shell record     start or stop a screen recording (Windows+Alt+R)
set -u

data=${KRISS_SHELL_DATA:-/usr/share/kriss-shell}
qml=$data/qml

case "${1:-}" in
launcher)
    # Fall back to COSMIC's own launcher when the KrissOS Shell is not running.
    qs -p "$qml" ipc call launcher toggle 2>/dev/null || exec cosmic-launcher
    ;;
quick | notifications | calendar | widgets)
    qs -p "$qml" ipc call "$1" toggle
    ;;
lock)
    qs -p "$qml" ipc call lock lock 2>/dev/null || exec loginctl lock-session
    ;;
desktop)
    qs -p "$qml" ipc call desktop toggle
    ;;
taskview)
    qs -p "$qml" ipc call taskview toggle
    ;;
desktops)
    qs -p "$qml" ipc call desktops "${2:?usage: kriss-shell desktops add|close}"
    ;;
clipboard)
    qs -p "$qml" ipc call clipboard history
    ;;
emoji)
    qs -p "$qml" ipc call clipboard emoji
    ;;
personalise)
    qs -p "$qml" ipc call personalise open "${2:-colours}"
    ;;
settings)
    qs -p "$qml" ipc call settings open "${2:-}"
    ;;
project)
    qs -p "$qml" ipc call project toggle
    ;;
snap)
    qs -p "$qml" ipc call snap layouts
    ;;
layout)
    case "${2:-}" in
    windows | mac) qs -p "$qml" ipc call layout set "$2" ;;
    "") qs -p "$qml" ipc call layout get ;;
    *) echo "usage: kriss-shell layout windows|mac" >&2; exit 2 ;;
    esac
    ;;
input)
    # Without the shell, fcitx5 still switches: toggle between the first and the last used.
    qs -p "$qml" ipc call input "${2:-next}" 2>/dev/null || exec fcitx5-remote -t
    ;;
switcher | media)
    qs -p "$qml" ipc call "$1" "${2:?usage: kriss-shell $1 ACTION}"
    ;;
taskbar)
    qs -p "$qml" ipc call taskbar "${2:?usage: kriss-shell taskbar ACTION [N]}" ${3:+"$3"}
    ;;
brightness)
    # The brightness keys: set it and show the level, or just set it without the shell.
    qs -p "$qml" ipc call osd brightness "${2:?usage: kriss-shell brightness 5%+}" 2>/dev/null ||
        exec brightnessctl -q -c backlight set "$2"
    ;;
record)
    # Windows+Alt+R: start or stop a screen recording.
    exec qs -p "$qml" ipc call snip record
    ;;
screenshot)
    # Windows+Shift+S (region): the snipping bar, whose Rectangle comes back here as `area`.
    if [ "${2:-}" = region ] && qs -p "$qml" ipc call snip toggle 2>/dev/null; then exit 0; fi
    dir=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots
    file=$dir/Screenshot_$(date +%Y%m%d_%H%M%S).png
    mkdir -p "$dir"
    if [ "${2:-}" = region ] || [ "${2:-}" = area ]; then
        area=$(slurp) || exit 0  # Escape cancels
        grim -g "$area" "$file" || exit 1
    else
        grim "$file" || exit 1
    fi
    wl-copy --type image/png < "$file"
    case ${LANGUAGE:-${LC_ALL:-${LANG:-}}} in
    ms*) title="Tangkapan skrin disimpan" body="${file##*/} juga ada dalam papan keratan." ;;
    *) title="Screenshot saved" body="${file##*/} is also on the clipboard." ;;
    esac
    notify-send -a Screenshot -i "$file" "$title" "$body" 2>/dev/null
    ;;
switch-user)
    # Start > account menu > Switch user: lock this session, then a login screen on another
    # VT (kriss-switch-user@.service, a second greetd; polkit lets the person at the PC start
    # it), or back to that one if it is up already. The login screen's "Back to" buttons and
    # this session's lock screen bring them back here.
    qs -p "$qml" ipc call lock lock 2>/dev/null || loginctl lock-session
    sleep 0.5
    greeter=$(loginctl list-sessions --no-legend | awk '$3 == "greeter" { print $1; exit }')
    if [ -n "$greeter" ]; then
        exec loginctl activate "$greeter"
    fi
    # A new instance each time: one that someone signed in through is that person's session now,
    # and starting it again would do nothing.
    exec systemctl start "kriss-switch-user@$(date +%s).service"
    ;;
greeter)
    # greetd's greeter user has no home, and cosmic-comp keeps running after its command
    # exits, so give it one under the runtime dir and stop cosmic-comp once the login
    # screen hands over to the session.
    set -a; . /etc/locale.conf 2>/dev/null; set +a
    export HOME="$XDG_RUNTIME_DIR/kriss-greeter"
    mkdir -p "$HOME"
    cp -r /etc/skel/.icons "$HOME/" 2>/dev/null  # the KrissOS cursor (kriss-settings)
    # shellcheck disable=SC2016 # $1 and $PPID belong to the inner shell
    exec cosmic-comp sh -c 'qs -p "$1"; kill "$PPID"' sh "$qml/greeter.qml"
    ;;
--inside)
    # The shell inside a running cosmic-comp. Also how to run it nested for development.
    # ponytail: restart the shell after a crash so open apps survive it; a clean exit
    # (Sign out in the launcher) ends the session. A crash loop retries once a second.
    # The kernel backs memory with 2 MB huge pages for every process (THP "always"), which
    # adds about 110 MB to the shell's half-used heap for no speed it needs. Turn them off for
    # qs and its helpers only (prctl PR_SET_THP_DISABLE, kept across exec); python3 comes with
    # python-pywayland.
    nothp='import ctypes, os, sys; ctypes.CDLL(None).prctl(41, 1, 0, 0, 0); os.execvp(sys.argv[1], sys.argv[1:])'
    while :; do
        # The icon pack: COSMIC's setting, which Settings > Personalise > Icons changes (and
        # then restarts the shell, since Quickshell reads it only at start).
        QS_ICON_THEME=$(tr -d '"' < "${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/com.system76.CosmicTk/v1/icon_theme" 2>/dev/null)
        export QS_ICON_THEME="${QS_ICON_THEME:-Papirus-Dark}"
        python3 -c "$nothp" qs -p "$qml" && exit 0
        sleep 1
    done
    ;;
"")
    # The guest account (`kriss guest on`): every sign-in starts from a fresh home.
    if [ "$(id -un)" = guest ] && [ -e /var/lib/kriss/guest ] && [ "$HOME" = /home/guest ]; then
        find /home/guest -mindepth 1 -delete 2>/dev/null
        cp -a /etc/skel/. /home/guest/
        cd /home/guest || exit 1
    fi
    export XDG_CURRENT_DESKTOP=KrissOS:COSMIC XDG_SESSION_DESKTOP=KrissOS XDG_SESSION_TYPE=wayland
    # The qt6ct config from kriss-settings only applies with this set (see its PKGBUILD).
    export QT_QPA_PLATFORMTHEME=qt6ct
    # Input methods (fcitx5, from kriss-settings). Wayland apps reach it through text-input
    # on their own, GTK ones included, so there is no GTK_IM_MODULE. These cover Qt apps
    # that fall back to fcitx's own module, and X11 apps and games under XWayland (XIM).
    export XMODIFIERS=@im=fcitx QT_IM_MODULES="wayland;fcitx"

    # COSMIC defaults: the Windows key opens our launcher, Windows+L locks, the KrissOS
    # dark and light themes (accent, backgrounds, corners; no coloured ring around the
    # focused window), Papirus icons, the KrissOS fonts and terminal colours. Copied key by key
    # only where the user has no value of their own, so their changes win.
    cfg=${XDG_CONFIG_HOME:-$HOME/.config}/cosmic
    # merge DEFAULTS USERFILE: add the KrissOS shortcuts the user's file lacks, matched by
    # their modifiers and key whatever the layout (COSMIC Settings saves it pretty-printed).
    # Each one is offered once (~/.local/state/kriss/shortcuts-offered), so one the user
    # removed stays removed and one they rebound is left as theirs.
    merge() {
        python3 - "$1" "$2" "${XDG_STATE_HOME:-$HOME/.local/state}/kriss/shortcuts-offered" <<'EOF' || true
import os, re, sys

defaults, user, state = sys.argv[1:4]
name = os.path.basename(user)


def entries(text):
    """The top-level entries of a RON map: [(key, whole entry)], comments left out."""
    text = re.sub(r"//[^\n]*", "", text)
    out, depth, start, quote = [], 0, None, False
    for i, c in enumerate(text):
        if quote:
            if c == '"' and text[i - 1] != "\\":
                quote = False
            continue
        if c == '"':
            quote = True
        elif c in "([{":
            depth += 1
            if depth == 2 and start is None:
                start = i
        elif c in ")]}":
            depth -= 1
        elif c == "," and depth == 1 and start is not None:
            out.append(text[start:i])
            start = None
        elif depth == 1 and start is None and not c.isspace():
            start = i
    if start is not None and text[start:].strip("} \n\t"):
        out.append(text[start:text.rindex("}")])
    result = []
    for e in out:
        e = e.strip()
        d = 0
        for i, c in enumerate(e):
            d += c in "([{"
            d -= c in ")]}"
            if c == ":" and d == 0:
                result.append((norm(e[:i]), e))
                break
    return result


def norm(key):
    key = re.sub(r"\s+", "", key).replace(",)", ")").replace(",]", "]")
    m = re.search(r"modifiers:\[([^\]]*)\]", key)
    if m:
        mods = ",".join(sorted(x for x in m.group(1).split(",") if x))
        key = key[: m.start(1)] + mods + key[m.end(1) :]
    return key


try:
    text = open(user).read()
except FileNotFoundError:
    sys.exit(0)
have = {k for k, _ in entries(text)}
try:
    offered = set(open(state).read().splitlines())
except FileNotFoundError:
    offered = set()
add, seen = [], []
for k, e in entries(open(defaults).read()):
    tag = name + "\t" + k
    if k not in have and tag not in offered:
        add.append(e)
    if tag not in offered:
        seen.append(tag)
if add:
    head, tail = text[: text.rindex("}")].rstrip(), text[text.rindex("}") :]
    if not head.endswith(("{", ",")):
        head += ","
    new = head + "\n" + "".join("    " + e + ",\n" for e in add) + tail
    with open(user + ".new", "w") as f:
        f.write(new)
    os.replace(user + ".new", user)
if seen:
    os.makedirs(os.path.dirname(state), exist_ok=True)
    with open(state, "a") as f:
        f.write("".join(t + "\n" for t in seen))
EOF
    }
    for dir in "$data"/cosmic/*/v*; do
        rel=${dir#"$data/cosmic/"}
        mkdir -p "$cfg/$rel"
        for f in "$dir"/*; do
            [ -e "$cfg/$rel/${f##*/}" ] || cp "$f" "$cfg/$rel/"
        done
    done
    # A newer kriss-shell can bring new shortcuts (Alt+Tab and the media keys came in 0.2.7,
    # Windows+Alt+R in 0.2.18): add each one the user's file lacks (merge, above).
    sc=com.system76.CosmicSettings.Shortcuts/v1
    for f in "$data/cosmic/$sc"/*; do
        merge "$f" "$cfg/$sc/${f##*/}"
    done
    # The brightness keys used to call brightnessctl directly, which shows no level.
    # Move the old defaults over; a key the user changed is left alone.
    # ponytail: drop this once installs from before kriss-shell 0.2.6 are gone.
    sed -i 's|"brightnessctl -q -c backlight set \(5%[-+]\)"|"kriss-shell brightness \1"|' \
        "$cfg/$sc/system_actions" 2>/dev/null || true

    # The language and formats chosen in Settings > Time and language. /etc/profile.d/locale.sh
    # reads this file only when LANG is unset, and the login has set it from /etc/locale.conf.
    loc=${XDG_CONFIG_HOME:-$HOME/.config}/locale.conf
    if [ -r "$loc" ]; then
        set -a
        . "$loc"
        set +a
        systemctl --user import-environment LANG LANGUAGE LC_TIME LC_NUMERIC LC_MONETARY LC_PAPER LC_MEASUREMENT 2>/dev/null || true
    fi

    # Not `cosmic-comp COMMAND`: that is cosmic-comp's kiosk mode, which turns off every
    # keyboard shortcut. Start it on its own; once it is ready it publishes
    # WAYLAND_DISPLAY and DISPLAY to the systemd user environment, so wait for that.
    systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY
    cosmic-comp &
    comp=$!
    tries=0
    until env=$(systemctl --user show-environment | grep -E '^(WAYLAND_DISPLAY|DISPLAY)=') &&
        echo "$env" | grep -q '^WAYLAND_DISPLAY='; do
        kill -0 "$comp" 2>/dev/null || exit 1
        tries=$((tries + 1))
        [ "$tries" -lt 300 ] || { kill "$comp"; exit 1; }  # 30 s
        sleep 0.1
    done
    # shellcheck disable=SC2086,SC2163 # one NAME=value per line; values are socket names, no spaces
    export $env
    dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP XDG_SESSION_TYPE QT_QPA_PLATFORMTHEME \
        XMODIFIERS QT_IM_MODULES 2>/dev/null
    # Switches light and dark (by hand or at sunset) and keeps the gsettings icon theme and
    # fonts in step with COSMIC's, so COSMIC apps and the terminal follow the mode live.
    cosmic-settings-daemon &
    daemon=$!
    # Turns the screens off and puts the PC to sleep after the times in Settings > Power and
    # battery (com.system76.CosmicIdle), locking as the screens go off; videos and games that
    # ask the screen to stay on hold it off.
    cosmic-idle &
    idle=$!
    # Apps in /etc/xdg/autostart and ~/.config/autostart, such as kriss-welcome on first
    # login, through systemd's XDG autostart units.
    systemctl --user --no-block start kriss-shell-session.target
    # Clipboard history keeps only pinned items from one session to the next (also after a crash).
    kriss-shell-clipboard clear 2>/dev/null
    # The ISO boot test waits for this line.
    logger -t kriss-shell "KrissOS Shell started on $WAYLAND_DISPLAY" 2>/dev/null

    "$0" --inside
    kriss-shell-clipboard clear 2>/dev/null
    systemctl --user stop kriss-shell-session.target graphical-session.target
    kill "$daemon" "$idle" "$comp" 2>/dev/null
    wait "$comp"
    ;;
*)
    echo "usage: kriss-shell [launcher|quick|notifications|calendar|widgets|lock|desktop|taskview|desktops add|clipboard|emoji|snap|layout windows|mac|input next|taskbar ACTION|switcher next|media playPause|brightness STEP|screenshot [region]|greeter]" >&2
    exit 2
    ;;
esac
