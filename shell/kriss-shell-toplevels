#!/usr/bin/env python3
"""Tell the KrissOS Shell which windows are open, act on them, and capture previews.

Quickshell lists windows through wlr-foreign-toplevel-management, which
cosmic-comp does not offer. cosmic-comp has ext-foreign-toplevel-list plus its
own cosmic-toplevel-info/-management instead, so this helper speaks those.
Quickshell's ScreencopyView cannot capture one window there either (it has no
ext-foreign-toplevel capture source), so the taskbar previews come from here too,
through ext-image-copy-capture.

stdout: one JSON array per change, e.g.
  [{"id": 3, "appId": "firefox", "title": "Inbox", "active": true, "minimized": false,
    "output": "DP-1"}]
  and, while previews are captured, one object per new picture:
  {"thumb": 3, "url": "file:///run/user/1000/kriss-shell-thumbs-wayland-1/3.bmp?7"}
stdin:  one command per line: "activate ID", "minimize ID", "close ID", or
  "thumbs SIZE ID ID ..." to capture those windows at about SIZE pixels on the long
  edge ("thumbs 0" stops capturing).

Bindings are generated at package build time into /usr/lib/kriss-shell
(see pkgs/kriss-shell/PKGBUILD). KRISS_SHELL_LIB overrides that for development.
"""
import json
import mmap
import os
import select
import shutil
import struct
import sys
import time

sys.path.insert(0, os.environ.get("KRISS_SHELL_LIB", "/usr/lib/kriss-shell"))

from pywayland.client import Display  # noqa: E402

from kriss_protocols.cosmic_toplevel_info_unstable_v1 import ZcosmicToplevelInfoV1  # noqa: E402
from kriss_protocols.cosmic_toplevel_management_unstable_v1 import ZcosmicToplevelManagerV1  # noqa: E402
from kriss_protocols.ext_foreign_toplevel_list_v1 import ExtForeignToplevelListV1  # noqa: E402
from kriss_protocols.ext_image_capture_source_v1 import (  # noqa: E402
    ExtForeignToplevelImageCaptureSourceManagerV1)
from kriss_protocols.ext_image_copy_capture_v1 import ExtImageCopyCaptureManagerV1  # noqa: E402
from kriss_protocols.wayland import WlOutput, WlSeat, WlShm  # noqa: E402

MINIMIZED, ACTIVATED = 1, 2  # zcosmic_toplevel_handle_v1.state entries
# 32-bit wl_shm formats the previews can use: (red, green, blue, alpha) bit masks of a
# little-endian pixel. cosmic-comp 1.11 offers only ABGR and XBGR for shm.
FORMATS = {
    0: (0xFF0000, 0xFF00, 0xFF, 0xFF000000),  # ARGB8888
    1: (0xFF0000, 0xFF00, 0xFF, 0),  # XRGB8888
    0x34324241: (0xFF, 0xFF00, 0xFF0000, 0xFF000000),  # ABGR8888 ("AB24")
    0x34324258: (0xFF, 0xFF00, 0xFF0000, 0),  # XBGR8888 ("XB24")
}
FAILED_CONSTRAINTS, FAILED_STOPPED = 1, 2  # ext_image_copy_capture_frame_v1.failure_reason
# Captured pixels have premultiplied alpha and BMP's is straight, so a translucent window
# would be darkened twice. Any alpha above 0 becomes opaque instead: such a window shows as
# it would over black, and transparent corners stay transparent.
SOLID = bytes([0] + [255] * 255)
FRAME_GAP = 0.1  # s: previews update at most 10 times a second
THUMBS = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                      "kriss-shell-thumbs-" + os.path.basename(os.environ.get("WAYLAND_DISPLAY", "wayland-0")))


def states(raw):
    """The state event's array is packed native-endian uint32s."""
    return {int.from_bytes(raw[i:i + 4], sys.byteorder) for i in range(0, len(raw), 4)}


def bmp(pixels, width, height, masks):
    """A top-down 32-bit BMP around the captured pixels as they are: Qt reads it directly."""
    head = struct.pack("<IiiHHIIiiII", 108, width, -height, 1, 32, 3, len(pixels), 2835, 2835, 0, 0)
    v4 = head + struct.pack("<IIIII", *masks, 0x73524742) + bytes(48)  # colour space endpoints and gamma, unused for sRGB
    return struct.pack("<2sIHHI", b"BM", 14 + len(v4) + len(pixels), 0, 0, 14 + len(v4)) + v4 + pixels


def shrink(buf, width, height, step):
    """Every step-th pixel of every step-th row: nearest-neighbour, at C speed."""
    px = memoryview(buf).cast("I")
    rows = [px[y * width:(y + 1) * width:step] for y in range(0, height, step)]
    return b"".join(r.tobytes() for r in rows), len(rows[0]), len(rows)


class Capture:
    """Pictures of one window, one frame after another while its preview is shown.
    cosmic-comp only answers a frame once the window has changed, so a still window costs nothing."""

    def __init__(self, tops, wid, handle):
        self.tops, self.wid = tops, wid
        self.size = 0
        self.width = self.height = 0
        self.formats = set()
        self.buffer = self.pool = self.map = None
        self.frame = None
        self.count = 0
        source = tops.globals["ext_foreign_toplevel_image_capture_source_manager_v1"].create_source(handle)
        self.session = tops.globals["ext_image_copy_capture_manager_v1"].create_session(source, 0)
        source.destroy()
        self.session.dispatcher["buffer_size"] = self.on_size
        self.session.dispatcher["shm_format"] = lambda _s, f: self.formats.add(f)
        self.session.dispatcher["done"] = self.on_done
        self.session.dispatcher["stopped"] = lambda _s: self.stop()

    def on_size(self, _s, width, height):
        self.width, self.height = width, height

    def on_done(self, _s):
        self.format = next((f for f in FORMATS if f in self.formats), None)
        if self.format is None:
            return self.stop()
        stride = self.width * 4
        if self.map is None or len(self.map) != stride * self.height:
            self.free_buffer()
            fd = os.memfd_create("kriss-thumb")
            os.ftruncate(fd, stride * self.height)
            self.map = mmap.mmap(fd, stride * self.height)
            self.pool = self.tops.globals["wl_shm"].create_pool(fd, stride * self.height)
            os.close(fd)
            self.buffer = self.pool.create_buffer(0, self.width, self.height, stride, self.format)
        if self.frame is None:
            self.capture()

    def capture(self):
        if self.session is None or self.buffer is None or self.frame is not None:
            return
        self.frame = self.session.create_frame()
        self.frame.attach_buffer(self.buffer)
        self.frame.damage_buffer(0, 0, self.width, self.height)
        self.frame.dispatcher["ready"] = self.on_ready
        self.frame.dispatcher["failed"] = self.on_failed
        self.frame.capture()

    def on_ready(self, _f):
        self.frame.destroy()
        self.frame = None
        step = max(1, max(self.width, self.height) // max(1, self.size))
        pixels, w, h = shrink(self.map, self.width, self.height, step)
        if FORMATS[self.format][3]:
            pixels = bytearray(pixels)
            pixels[3::4] = pixels[3::4].translate(SOLID)
        path = os.path.join(THUMBS, f"{self.wid}.bmp")
        with open(path + ".new", "wb") as f:
            f.write(bmp(pixels, w, h, FORMATS[self.format]))
        os.replace(path + ".new", path)
        self.count += 1
        print(json.dumps({"thumb": self.wid, "url": f"file://{path}?{self.count}"}), flush=True)
        self.tops.later(FRAME_GAP, self.capture)

    def on_failed(self, _f, reason):
        self.frame.destroy()
        self.frame = None
        if reason == FAILED_STOPPED:
            self.stop()
        elif reason != FAILED_CONSTRAINTS:  # new constraints come with a done event, which retries
            self.tops.later(1, self.capture)

    def free_buffer(self):
        if self.buffer:
            self.buffer.destroy()
            self.pool.destroy()
            self.map.close()
        self.buffer = self.pool = self.map = None

    def stop(self):
        if self.frame:
            self.frame.destroy()
            self.frame = None
        if self.session:
            self.session.destroy()
            self.session = None
        self.free_buffer()
        self.tops.captures.pop(self.wid, None)


class Toplevels:
    def __init__(self, display):
        self.display = display
        self.globals = {}
        self.windows = {}  # id -> {"appId", "title", "active", "minimized", "output"}
        self.handles = {}  # id -> (ext handle, cosmic handle)
        self.outputs = {}  # wl_output proxy -> connector name, e.g. "DP-1"
        self.captures = {}  # id -> Capture, only while the shell shows that window's preview
        self.timers = []  # [(when, function)]
        self.next_id = 1

    def on_global(self, registry, name, interface, version):
        wanted = {
            "ext_foreign_toplevel_list_v1": (ExtForeignToplevelListV1, 1),
            "zcosmic_toplevel_info_v1": (ZcosmicToplevelInfoV1, 3),
            "zcosmic_toplevel_manager_v1": (ZcosmicToplevelManagerV1, 4),
            "ext_foreign_toplevel_image_capture_source_manager_v1": (ExtForeignToplevelImageCaptureSourceManagerV1, 1),
            "ext_image_copy_capture_manager_v1": (ExtImageCopyCaptureManagerV1, 1),
            "wl_shm": (WlShm, 1),
            "wl_seat": (WlSeat, 1),
        }
        if interface == "wl_output" and version >= 4:
            # Every screen, including ones plugged in later. ponytail: unplugged ones
            # are not forgotten; a stale name in the dict is harmless.
            output = registry.bind(name, WlOutput, 4)
            output.dispatcher["name"] = lambda o, n: self.outputs.__setitem__(o, n)
        elif interface in wanted and interface not in self.globals:
            iface, ours = wanted[interface]
            self.globals[interface] = registry.bind(name, iface, min(version, ours))

    def start(self):
        registry = self.display.get_registry()
        registry.dispatcher["global"] = self.on_global
        self.display.roundtrip()
        missing = {"ext_foreign_toplevel_list_v1", "zcosmic_toplevel_info_v1",
                   "zcosmic_toplevel_manager_v1", "wl_seat"} - self.globals.keys()
        if missing:
            sys.exit(f"kriss-shell-toplevels: compositor lacks {', '.join(sorted(missing))}")
        self.globals["ext_foreign_toplevel_list_v1"].dispatcher["toplevel"] = self.on_toplevel
        # Pictures from an earlier run are for window ids that no longer mean the same.
        shutil.rmtree(THUMBS, ignore_errors=True)
        os.makedirs(THUMBS, mode=0o700, exist_ok=True)

    def on_toplevel(self, _list, handle):
        wid = self.next_id
        self.next_id += 1
        win = {"appId": "", "title": "", "active": False, "minimized": False, "output": ""}
        self.windows[wid] = win
        cosmic = self.globals["zcosmic_toplevel_info_v1"].get_cosmic_toplevel(handle)
        self.handles[wid] = (handle, cosmic)

        def set_field(key):
            return lambda _h, value: win.__setitem__(key, value)

        def on_state(_h, raw):
            s = states(raw)
            win["active"], win["minimized"] = ACTIVATED in s, MINIMIZED in s
            self.emit()

        def on_closed(_h):
            if wid in self.captures:
                self.captures[wid].stop()
            self.windows.pop(wid, None)
            self.handles.pop(wid, None)
            cosmic.destroy()
            handle.destroy()
            try:
                os.remove(os.path.join(THUMBS, f"{wid}.bmp"))
            except OSError:
                pass
            self.emit()

        def on_output(_h, output):
            win["output"] = self.outputs.get(output, "")
            self.emit()

        handle.dispatcher["app_id"] = set_field("appId")
        handle.dispatcher["title"] = set_field("title")
        handle.dispatcher["done"] = lambda _h: self.emit()
        handle.dispatcher["closed"] = on_closed
        cosmic.dispatcher["state"] = on_state
        cosmic.dispatcher["output_enter"] = on_output

    def emit(self):
        print(json.dumps([w | {"id": wid} for wid, w in self.windows.items()]), flush=True)

    def thumbs(self, size, ids):
        """Capture exactly these windows (the preview on screen), and stop the rest."""
        if "ext_image_copy_capture_manager_v1" not in self.globals:
            return
        for wid in list(self.captures):
            if wid not in ids:
                self.captures[wid].stop()
        for wid in ids:
            if wid in self.handles and wid not in self.captures:
                self.captures[wid] = Capture(self, wid, self.handles[wid][0])
            if wid in self.captures:
                self.captures[wid].size = size

    def command(self, line):
        verb, *args = line.split()
        if verb == "thumbs" and args and all(a.isdigit() for a in args):
            self.thumbs(int(args[0]), [int(a) for a in args[1:]])
            return
        cosmic = self.handles.get(int(args[0]))[1] if args and args[0].isdigit() and int(args[0]) in self.handles else None
        if not cosmic:
            return
        manager = self.globals["zcosmic_toplevel_manager_v1"]
        if verb == "activate":
            manager.activate(cosmic, self.globals["wl_seat"])
        elif verb == "minimize":
            manager.set_minimized(cosmic)
        elif verb == "close":
            manager.close(cosmic)

    def later(self, delay, fn):
        self.timers.append((time.monotonic() + delay, fn))

    def run_timers(self):
        now = time.monotonic()
        due = [t for t in self.timers if t[0] <= now]
        self.timers = [t for t in self.timers if t[0] > now]
        for _, fn in due:
            fn()


def main():
    with Display() as display:
        tops = Toplevels(display)
        tops.start()
        tops.emit()

        # One thread: wait on the compositor and on the shell's commands together.
        # No timeout unless a preview is waiting for its next frame, so idle costs nothing.
        fd, pending = display.get_fd(), b""
        while True:
            display.dispatch(block=False)
            display.flush()
            wait = max(0, min(t for t, _ in tops.timers) - time.monotonic()) if tops.timers else None
            ready, _, _ = select.select([fd, 0], [], [], wait)
            if fd in ready:
                display.read()
                display.dispatch(block=False)
            if 0 in ready:
                data = os.read(0, 4096)
                if not data:
                    return  # stdin closed: the shell is gone
                *lines, pending = (pending + data).split(b"\n")
                for line in lines:
                    if line.strip():
                        tops.command(line.decode(errors="replace"))
            tops.run_timers()


if __name__ == "__main__":
    main()
