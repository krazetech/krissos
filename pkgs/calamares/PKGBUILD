# Maintainer: Kraze Tech
# Calamares is not in Arch's official repos, so [kriss] carries a pinned build of the
# upstream release. KrissOS's own config lives in kriss-installer.
pkgname=calamares
pkgver=3.4.3
pkgrel=1
pkgdesc='Distribution-independent installer framework'
arch=('x86_64')
url='https://codeberg.org/Calamares/calamares'
license=('GPL-3.0-or-later')
depends=('kcoreaddons' 'kpmcore' 'libpwquality' 'python' 'qt6-declarative' 'qt6-svg' 'yaml-cpp')
makedepends=('cmake' 'extra-cmake-modules' 'ninja' 'qt6-tools' 'qt6-translations')
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('144cbbf6bdcebfb21685950db4f0777218519df095f62f4aa392f28348110d18')

build() {
  # Modules for other init systems, initramfs tools and filesystems KrissOS does not use.
  local skip=(dracut dracutlukscfg dummycpp dummyprocess dummypython dummypythonqt
              initramfs initramfscfg interactiveterminal mkinitfs openrcdmcryptcfg
              services-openrc zfs zfshostid)
  cmake -B build -S "$pkgname-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DWITH_QT6=ON \
    -DINSTALL_CONFIG=ON \
    -DBUILD_TESTING=OFF \
    -DSKIP_MODULES="${skip[*]}" \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
