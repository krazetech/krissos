diff --git a/cosmic-settings/src/pages/desktop/personalise.rs b/cosmic-settings/src/pages/desktop/personalise.rs
new file mode 100644
index 0000000..a1c402b
--- /dev/null
+++ b/cosmic-settings/src/pages/desktop/personalise.rs
@@ -0,0 +1,91 @@
+// Copyright 2026 Kraze Tech
+// SPDX-License-Identifier: GPL-3.0-only
+
+// KrissOS: in the KrissOS Shell session, the shell draws the wallpaper and the taskbar, so
+// its own Personalise window replaces the Wallpaper, Panel and Dock pages. This page links
+// to each of that window's pages.
+
+use cosmic::widget::{self, settings};
+use cosmic::{Apply, Element};
+use cosmic_settings_page::{self as page, Section, section};
+use slotmap::SlotMap;
+
+/// The Personalise window's pages, as `kriss-shell personalise` names them.
+const PAGES: [&str; 5] = ["colours", "background", "taskbar", "pins", "text"];
+
+/// True in the KrissOS Shell session, which sets XDG_CURRENT_DESKTOP=KrissOS:COSMIC.
+pub fn active() -> bool {
+    std::env::var("XDG_CURRENT_DESKTOP").is_ok_and(|d| d.split(':').any(|d| d == "KrissOS"))
+}
+
+/// Opens the Personalise window at that page.
+pub fn open(page: &'static str) {
+    // The thread reaps the short-lived `kriss-shell` process.
+    std::thread::spawn(move || {
+        if let Err(err) = std::process::Command::new("kriss-shell")
+            .args(["personalise", page])
+            .status()
+        {
+            tracing::error!(?err, "failed to open Personalise");
+        }
+    });
+}
+
+#[derive(Default)]
+pub struct Page;
+
+impl page::Page<crate::pages::Message> for Page {
+    fn info(&self) -> page::Info {
+        page::Info::new("personalise", "preferences-desktop-wallpaper-symbolic")
+            .title(fl!("kriss-personalise"))
+            .description(fl!("kriss-personalise-desc"))
+    }
+
+    fn content(
+        &self,
+        sections: &mut SlotMap<section::Entity, Section<crate::pages::Message>>,
+    ) -> Option<page::Content> {
+        Some(vec![sections.insert(links())])
+    }
+}
+
+impl page::AutoBind<crate::pages::Message> for Page {}
+
+fn links() -> Section<crate::pages::Message> {
+    // A title and a description for each of PAGES, in order.
+    let mut descriptions = slab::Slab::new();
+    for text in [
+        fl!("kriss-colours"),
+        fl!("kriss-colours-desc"),
+        fl!("kriss-background"),
+        fl!("kriss-background-desc"),
+        fl!("kriss-taskbar"),
+        fl!("kriss-taskbar-desc"),
+        fl!("kriss-pins"),
+        fl!("kriss-pins-desc"),
+        fl!("kriss-text"),
+        fl!("kriss-text-desc"),
+    ] {
+        descriptions.insert(text);
+    }
+
+    Section::default()
+        .title(fl!("kriss-personalise"))
+        .descriptions(descriptions)
+        .view::<Page>(move |_binder, _page, section| {
+            let d = &section.descriptions;
+            // No heading: the page's own title already says Personalise.
+            let mut list = settings::section();
+            for (i, id) in PAGES.into_iter().enumerate() {
+                list = list.add(
+                    settings::item::builder(&d[i * 2])
+                        .description(&d[i * 2 + 1])
+                        .control(
+                            widget::button::standard(fl!("kriss-open"))
+                                .on_press(crate::pages::desktop::Message::Personalise(id)),
+                        ),
+                );
+            }
+            list.apply(Element::from).map(crate::pages::Message::Desktop)
+        })
+}
