# Maintainer: Kraze Tech
pkgname=kriss-meta-winapps
pkgver=3
pkgrel=1
pkgdesc='KrissOS Windows apps pack: WinPodX with rootless Podman and FreeRDP 3'
arch=('any')
url='https://github.com/krazetech/krissos'
license=('GPL-3.0-or-later')
# WinPodX's default backend is rootless Podman with podman-compose. KVM is in the kernel;
# `kriss winapps setup` checks the module and /dev/kvm. xdg-utils and desktop-file-utils:
# WinPodX makes each Windows app the handler for its file types (xdg-mime) in Start.
depends=('podman' 'podman-compose' 'freerdp>=3' 'xdg-utils' 'desktop-file-utils')

package() {
  # Added here, not above: CI resolves the list above against Arch's repos only.
  depends+=('winpodx' 'kriss-tools>=0.10.0')
}
