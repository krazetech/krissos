+
+/// KrissOS: which title bar buttons show and on which side, in GNOME's button-layout form
+/// (`window_buttons` in com.system76.CosmicTk): ":minimize,maximize,close" puts them on the
+/// right, "close,minimize,maximize:" on the left. Without a colon they go on the right.
+static WINDOW_BUTTONS: RwLock<String> = RwLock::new(String::new());
+
+/// Returns whether the layout changed.
+pub fn set_window_buttons(layout: String) -> bool {
+    let mut current = WINDOW_BUTTONS.write().unwrap();
+    let changed = *current != layout;
+    *current = layout;
+    changed
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Control {
+    Minimize,
+    Maximize,
+    Close,
+}
+
+/// The buttons on the left and on the right, in order.
+fn button_layout() -> [Vec<Control>; 2] {
+    let layout = WINDOW_BUTTONS.read().unwrap();
+    let (left, right) = layout
+        .split_once(':')
+        .unwrap_or(("", "minimize,maximize,close"));
+    let parse = |side: &str| {
+        side.split(',')
+            .filter_map(|name| match name.trim() {
+                "minimize" if cosmic::config::show_minimize() => Some(Control::Minimize),
+                "maximize" if cosmic::config::show_maximize() => Some(Control::Maximize),
+                "close" => Some(Control::Close),
+                _ => None,
+            })
+            .collect::<Vec<_>>()
+    };
+    [parse(left), parse(right)]
+}
+
+// The "KrissOS round" glyphs, recoloured for light and dark: thin, rounded, 16 px.
+const GLYPH_MINIMIZE: &[u8] = br##"<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><path d="M4 8h8" fill="none" stroke="#000" stroke-width="1.25" stroke-linecap="round"/></svg>"##;
+const GLYPH_MAXIMIZE: &[u8] = br##"<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><rect x="4.125" y="4.125" width="7.75" height="7.75" rx="2" fill="none" stroke="#000" stroke-width="1.25"/></svg>"##;
+const GLYPH_RESTORE: &[u8] = br##"<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><rect x="3.625" y="5.625" width="6.75" height="6.75" rx="1.5" fill="none" stroke="#000" stroke-width="1.25"/><path d="M6 3.625h4.375a2 2 0 0 1 2 2V10" fill="none" stroke="#000" stroke-width="1.25" stroke-linecap="round"/></svg>"##;
+const GLYPH_CLOSE: &[u8] = br##"<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><path d="M4.75 4.75l6.5 6.5M11.25 4.75l-6.5 6.5" fill="none" stroke="#000" stroke-width="1.25" stroke-linecap="round"/></svg>"##;
+// Close turns red under the pointer, as on Windows; the same red reads on light and dark.
+const CLOSE_RED: Color = Color::from_rgb(0.769, 0.169, 0.110);
+const CLOSE_RED_PRESSED: Color = Color::from_rgb(0.698, 0.153, 0.098);
 pub const RESIZE_BORDER: i32 = 10;
 
