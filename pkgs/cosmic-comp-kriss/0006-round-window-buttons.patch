+    /// One "KrissOS round" button: a soft circle in a 46 x 32 px target (Windows 11's caption
+    /// buttons are 46 px wide), tinted with the accent under the pointer; close turns red.
+    fn control(&self, control: Control, focused: bool) -> cosmic::Element<'static, Message> {
+        use cosmic::{iced::Length, widget};
+        let hovered = self.hovered == Some(control);
+        let pressed = hovered && self.pressed == Some(control);
+        let danger = hovered && control == Control::Close;
+        let glyph = match control {
+            Control::Minimize => GLYPH_MINIMIZE,
+            Control::Maximize if self.window.is_maximized(false) => GLYPH_RESTORE,
+            Control::Maximize => GLYPH_MAXIMIZE,
+            Control::Close => GLYPH_CLOSE,
+        };
+        let glyph = widget::svg(widget::svg::Handle::from_memory(glyph))
+            .width(Length::Fixed(16.0))
+            .height(Length::Fixed(16.0))
+            .class(cosmic::theme::Svg::custom(move |theme| {
+                let on = Color::from(theme.cosmic().background(false).on);
+                widget::svg::Style {
+                    color: Some(if danger {
+                        Color::WHITE
+                    } else if focused || hovered {
+                        on
+                    } else {
+                        Color { a: on.a * 0.5, ..on }
+                    }),
+                }
+            }));
+        let circle = widget::container(glyph)
+            .center(Length::Fixed(28.0))
+            .class(cosmic::theme::Container::custom(move |theme| {
+                let c = theme.cosmic();
+                let on = Color::from(c.background(false).on);
+                let accent = Color::from(c.accent_color());
+                let fill = match (danger, hovered, pressed) {
+                    (true, _, false) => CLOSE_RED,
+                    (true, _, true) => CLOSE_RED_PRESSED,
+                    (false, true, false) => Color { a: 0.24, ..accent },
+                    (false, true, true) => Color { a: 0.38, ..accent },
+                    _ => Color { a: if focused { 0.08 } else { 0.05 }, ..on },
+                };
+                widget::container::Style {
+                    background: Some(fill.into()),
+                    border: cosmic::iced::Border {
+                        radius: 14.0_f32.into(),
+                        ..Default::default()
+                    },
+                    ..Default::default()
+                }
+            }));
+        widget::mouse_area(
+            widget::container(circle)
+                .center_x(Length::Fixed(46.0))
+                .center_y(Length::Fixed(32.0)),
+        )
+        .on_enter(Message::Hover(control))
+        .on_exit(Message::Unhover(control))
+        .on_press(Message::Press(control))
+        .on_release(Message::Release(control))
+        .into()
+    }
 }
 
