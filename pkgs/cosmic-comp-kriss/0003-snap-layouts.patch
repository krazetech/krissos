diff --git a/src/wayland/protocols/kriss_snap.rs b/src/wayland/protocols/kriss_snap.rs
new file mode 100644
index 00000000..b4ea2595
--- /dev/null
+++ b/src/wayland/protocols/kriss_snap.rs
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// KrissOS snap layouts: see resources/protocols/kriss-snap-v1.xml.
+
+pub use generated::kriss_snap_manager_v1::{self, KrissSnapManagerV1};
+
+#[allow(non_snake_case, non_upper_case_globals, non_camel_case_types)]
+mod generated {
+    use smithay::reexports::wayland_server;
+
+    pub mod __interfaces {
+        use wayland_backend;
+        wayland_scanner::generate_interfaces!("resources/protocols/kriss-snap-v1.xml");
+    }
+    use self::__interfaces::*;
+
+    wayland_scanner::generate_server_code!("resources/protocols/kriss-snap-v1.xml");
+}
+
+use std::sync::Mutex;
+
+use smithay::reexports::wayland_server::{
+    Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, backend::ClientId,
+};
+
+use super::toplevel_info::ToplevelState;
+use crate::{
+    shell::{CosmicSurface, ModalBehavior, layout::floating::TiledCorners},
+    state::{ClientState, State},
+};
+
+static MANAGERS: Mutex<Vec<KrissSnapManagerV1>> = Mutex::new(Vec::new());
+static HOVERED: Mutex<Option<String>> = Mutex::new(None);
+
+pub fn init(dh: &DisplayHandle) {
+    dh.create_global::<State, KrissSnapManagerV1, _>(1, ());
+}
+
+fn identifier(window: &CosmicSurface) -> Option<String> {
+    let state = window.user_data().get::<ToplevelState>()?.lock().unwrap();
+    state.foreign_handle().map(|h| h.identifier())
+}
+
+/// The pointer is on `window`'s maximize button, or not. Tells the shell on changes only.
+pub fn maximize_hover(window: &CosmicSurface, hovered: bool) {
+    let Some(id) = identifier(window) else { return };
+    let mut current = HOVERED.lock().unwrap();
+    let was = current.as_ref() == Some(&id);
+    if was == hovered {
+        return;
+    }
+    if let Some(old) = current.take().filter(|_| hovered) {
+        send(&old, false);
+    }
+    if hovered {
+        *current = Some(id.clone());
+    }
+    send(&id, hovered);
+}
+
+fn send(id: &str, hovered: bool) {
+    for manager in MANAGERS.lock().unwrap().iter() {
+        manager.maximize_hover(id.to_string(), hovered as u32);
+    }
+}
+
+fn snap(state: &mut State, id: &str, zone: [u32; 4]) {
+    let [x, y, w, h] = zone.map(|v| v.min(12) as u8);
+    if w == 0 || h == 0 || x + w > 12 || y + h > 12 {
+        return;
+    }
+    let Some(window) = state
+        .common
+        .toplevel_info_state
+        .toplevels
+        .iter()
+        .find(|w| identifier(w).as_deref() == Some(id))
+        .cloned()
+    else {
+        return;
+    };
+    let mut shell = state.common.shell.write();
+    let Some(mapped) = shell.element_for_surface(&window).cloned() else {
+        return;
+    };
+    let seat = shell.seats.last_active().clone();
+    if (x, y, w, h) == (0, 0, 12, 12) {
+        shell.maximize_request(
+            &mapped,
+            &seat,
+            true,
+            &state.common.event_loop_handle,
+            ModalBehavior::Block,
+        );
+        return;
+    }
+    if mapped.maximized_state.lock().unwrap().is_some() {
+        shell.unmaximize_request(&mapped, ModalBehavior::Block);
+    }
+    let Some(workspace) = shell.space_for_mut(&mapped) else {
+        return;
+    };
+    // ponytail: floating windows only; cosmic-comp's tiling layout places its own windows.
+    if workspace.is_tiled(&window) {
+        return;
+    }
+    let zone = match (x, y, w, h) {
+        (0, 0, 6, 12) => TiledCorners::Left,
+        (6, 0, 6, 12) => TiledCorners::Right,
+        (0, 0, 12, 6) => TiledCorners::Top,
+        (0, 6, 12, 6) => TiledCorners::Bottom,
+        (0, 0, 6, 6) => TiledCorners::TopLeft,
+        (6, 0, 6, 6) => TiledCorners::TopRight,
+        (0, 6, 6, 6) => TiledCorners::BottomLeft,
+        (6, 6, 6, 6) => TiledCorners::BottomRight,
+        _ => TiledCorners::Zone(x, y, w, h),
+    };
+    workspace.floating_layer.tile_to(&mapped, zone);
+}
+
+impl GlobalDispatch<KrissSnapManagerV1, ()> for State {
+    fn bind(
+        _state: &mut State,
+        _dh: &DisplayHandle,
+        _client: &Client,
+        resource: New<KrissSnapManagerV1>,
+        _data: &(),
+        data_init: &mut DataInit<'_, State>,
+    ) {
+        MANAGERS.lock().unwrap().push(data_init.init(resource, ()));
+    }
+
+    fn can_view(client: Client, _data: &()) -> bool {
+        client
+            .get_data::<ClientState>()
+            .is_some_and(|c| c.not_sandboxed())
+    }
+}
+
+impl Dispatch<KrissSnapManagerV1, ()> for State {
+    fn request(
+        state: &mut State,
+        _client: &Client,
+        _resource: &KrissSnapManagerV1,
+        request: kriss_snap_manager_v1::Request,
+        _data: &(),
+        _dh: &DisplayHandle,
+        _data_init: &mut DataInit<'_, State>,
+    ) {
+        if let kriss_snap_manager_v1::Request::Snap {
+            toplevel,
+            x,
+            y,
+            width,
+            height,
+        } = request
+        {
+            snap(state, &toplevel, [x, y, width, height]);
+        }
+    }
+
+    fn destroyed(_state: &mut State, _client: ClientId, resource: &KrissSnapManagerV1, _data: &()) {
+        MANAGERS.lock().unwrap().retain(|m| m != resource);
+    }
+}
