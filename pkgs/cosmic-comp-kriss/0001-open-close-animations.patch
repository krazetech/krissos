diff --git a/src/shell/open_close.rs b/src/shell/open_close.rs
new file mode 100644
index 00000000..e7a29822
--- /dev/null
+++ b/src/shell/open_close.rs
@@ -0,0 +1,337 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Open and close animations for toplevel windows.
+//!
+//! Opening: the window fades in and grows from slightly smaller than its size.
+//! Closing: the window's last frame is copied into memory before it goes away, then drawn
+//! fading out and shrinking. Memory, not a texture, because every output renders on its own
+//! thread with its own GL context; each context imports the copy once.
+//!
+//! Both follow `org.gnome.desktop.interface enable-animations`.
+
+use std::{
+    collections::HashMap,
+    fmt,
+    io::{BufRead, BufReader},
+    process::{Command, Stdio},
+    sync::{
+        Mutex,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+use anyhow::Context;
+use keyframe::{ease, functions::EaseOutCubic};
+use smithay::{
+    backend::{
+        allocator::Fourcc,
+        renderer::{
+            ContextId, ExportMem, ImportAll, ImportMem, Offscreen, Renderer,
+            damage::OutputDamageTracker,
+            element::{Id, Kind, RenderElement, texture::TextureRenderElement},
+            gles::{GlesRenderbuffer, GlesTexture},
+            utils::with_renderer_surface_state,
+        },
+    },
+    desktop::space::SpaceElement,
+    reexports::wayland_server::protocol::wl_surface::WlSurface,
+    utils::{Buffer as BufferCoords, Coordinate, Logical, Point, Rectangle, Scale, Size, Transform},
+};
+use tracing::warn;
+
+use crate::{
+    backend::render::{RendererRef, element::AsGlowRenderer},
+    shell::element::{CosmicMapped, CosmicMappedRenderElement},
+    state::{State, advertised_node_for_surface},
+    utils::prelude::*,
+};
+
+pub const OPEN_DURATION: Duration = Duration::from_millis(180);
+pub const CLOSE_DURATION: Duration = Duration::from_millis(150);
+/// Size a window opens from and closes to, as a fraction of its own.
+const MIN_SCALE: f64 = 0.94;
+
+static ENABLED: AtomicBool = AtomicBool::new(true);
+
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// Follow GNOME's `enable-animations`, the desktop-wide switch the session's shell follows too.
+/// ponytail: a `gsettings monitor` child rather than linking GIO for one boolean.
+pub fn watch_enable_animations() {
+    const ARGS: [&str; 2] = ["org.gnome.desktop.interface", "enable-animations"];
+    let set = |line: &str| ENABLED.store(!line.contains("false"), Ordering::Relaxed);
+    std::thread::spawn(move || {
+        if let Ok(out) = Command::new("gsettings").arg("get").args(ARGS).output() {
+            set(&String::from_utf8_lossy(&out.stdout));
+        }
+        let mut cmd = Command::new("gsettings");
+        cmd.arg("monitor").args(ARGS).stdout(Stdio::piped());
+        // SAFETY: only calls prctl, which is async-signal-safe.
+        unsafe {
+            std::os::unix::process::CommandExt::pre_exec(&mut cmd, || {
+                rustix::process::set_parent_process_death_signal(Some(
+                    rustix::process::Signal::TERM,
+                ))
+                .map_err(Into::into)
+            });
+        }
+        let Ok(mut child) = cmd.spawn() else { return };
+        for line in BufReader::new(child.stdout.take().unwrap())
+            .lines()
+            .map_while(Result::ok)
+        {
+            set(&line);
+        }
+        let _ = child.wait();
+    });
+}
+
+fn progress(start: Instant, duration: Duration) -> Option<f64> {
+    let t = start.elapsed().as_secs_f64() / duration.as_secs_f64();
+    (t < 1.0).then(|| ease(EaseOutCubic, 0.0, 1.0, t))
+}
+
+/// `rect` scaled by `scale` around its centre.
+pub fn scale_rect<N: Coordinate, K>(rect: Rectangle<N, K>, scale: f64) -> Rectangle<N, K> {
+    let (w, h) = (rect.size.w.to_f64(), rect.size.h.to_f64());
+    let (sw, sh) = (w * scale, h * scale);
+    Rectangle::new(
+        (
+            N::from_f64(rect.loc.x.to_f64() + (w - sw) / 2.0),
+            N::from_f64(rect.loc.y.to_f64() + (h - sh) / 2.0),
+        )
+            .into(),
+        (N::from_f64(sw), N::from_f64(sh)).into(),
+    )
+}
+
+impl CosmicMapped {
+    pub fn start_open_animation(&self) {
+        if enabled() {
+            *self.opened_at.lock().unwrap() = Some(Instant::now());
+        }
+    }
+
+    /// Alpha and scale while the window is opening.
+    pub fn open_animation(&self) -> Option<(f32, f64)> {
+        let start = (*self.opened_at.lock().unwrap())?;
+        let e = progress(start, OPEN_DURATION)?;
+        Some((e as f32, MIN_SCALE + (1.0 - MIN_SCALE) * e))
+    }
+
+    /// Ends a finished open animation; true if one ended, so one more frame is due.
+    pub fn finish_open_animation(&self) -> bool {
+        let mut opened_at = self.opened_at.lock().unwrap();
+        if opened_at.is_some_and(|start| start.elapsed() >= OPEN_DURATION) {
+            *opened_at = None;
+            return true;
+        }
+        false
+    }
+}
+
+/// The last frame of a window that has gone away.
+pub struct ClosingWindow {
+    pixels: Vec<u8>,
+    size: Size<i32, BufferCoords>,
+    /// Where it was on the output, in logical pixels.
+    geometry: Rectangle<i32, Local>,
+    start: Instant,
+    textures: Mutex<HashMap<ContextId<GlesTexture>, GlesTexture>>,
+}
+
+impl fmt::Debug for ClosingWindow {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ClosingWindow")
+            .field("geometry", &self.geometry)
+            .field("start", &self.start)
+            .finish_non_exhaustive()
+    }
+}
+
+impl ClosingWindow {
+    pub fn is_done(&self) -> bool {
+        self.start.elapsed() >= CLOSE_DURATION
+    }
+
+    pub fn render_element<R: AsGlowRenderer>(
+        &self,
+        renderer: &mut R,
+        output_scale: f64,
+    ) -> Option<TextureRenderElement<GlesTexture>> {
+        let e = progress(self.start, CLOSE_DURATION)?;
+        let geometry = scale_rect(self.geometry.to_f64(), 1.0 - (1.0 - MIN_SCALE) * e);
+
+        let glow = renderer.glow_renderer_mut();
+        let context = glow.context_id();
+        let mut textures = self.textures.lock().unwrap();
+        let texture = match textures.get(&context) {
+            Some(texture) => texture.clone(),
+            None => {
+                let texture = glow
+                    .import_memory(&self.pixels, Fourcc::Abgr8888, self.size, false)
+                    .map_err(|err| warn!(?err, "Failed to import closing window"))
+                    .ok()?;
+                textures.insert(context.clone(), texture.clone());
+                texture
+            }
+        };
+
+        Some(TextureRenderElement::from_static_texture(
+            // A new id every frame: the element changes size and alpha every frame anyway.
+            Id::new(),
+            context,
+            geometry.loc.as_logical().to_physical(output_scale),
+            texture,
+            1,
+            Transform::Normal,
+            Some(1.0 - e as f32),
+            Some(Rectangle::from_size(
+                self.size.to_logical(1, Transform::Normal).to_f64(),
+            )),
+            Some(geometry.size.as_logical().to_i32_round()),
+            None,
+            Kind::Unspecified,
+        ))
+    }
+}
+
+fn snapshot<R>(
+    renderer: &mut R,
+    mapped: &CosmicMapped,
+    window_geometry: Rectangle<i32, Local>,
+    scale: f64,
+) -> anyhow::Result<ClosingWindow>
+where
+    R: Renderer + ImportAll + Offscreen<GlesRenderbuffer> + ExportMem + AsGlowRenderer,
+    R::TextureId: Send + Clone + 'static,
+    R::Error: Send + Sync + 'static,
+    CosmicMappedRenderElement<R>: RenderElement<R>,
+{
+    // The window plus its server-side title bar; the shadow is left out.
+    let bbox = mapped.bbox();
+    let size = bbox.size.to_physical_precise_round(scale);
+    let mut above = Vec::new();
+    let mut below = Vec::new();
+    mapped.push_render_elements(
+        renderer,
+        Point::<i32, Logical>::from((-bbox.loc.x, -bbox.loc.y)).to_physical_precise_round(scale),
+        None,
+        Scale::from(scale),
+        1.0,
+        None,
+        None,
+        &mut |elem| above.push(elem),
+        &mut |elem| below.push(elem),
+    );
+    above.append(&mut below);
+
+    let format = Fourcc::Abgr8888;
+    let buffer_size = Size::<i32, BufferCoords>::from((size.w, size.h));
+    let mut render_buffer =
+        Offscreen::<GlesRenderbuffer>::create_buffer(renderer, format, buffer_size)?;
+    let mut fb = renderer.bind(&mut render_buffer)?;
+    OutputDamageTracker::new(size, scale, Transform::Normal)
+        .render_output(renderer, &mut fb, 0, &above, [0.0; 4])
+        .map_err(|err| match err {
+            smithay::backend::renderer::damage::Error::Rendering(err) => err,
+            smithay::backend::renderer::damage::Error::OutputNoMode(_) => unreachable!(),
+        })?;
+    let mapping = renderer.copy_framebuffer(&fb, Rectangle::from_size(buffer_size), format)?;
+    let pixels = renderer.map_texture(&mapping)?.to_vec();
+
+    let mut geometry = bbox.as_local();
+    geometry.loc += window_geometry.loc - mapped.geometry().loc.as_local();
+    Ok(ClosingWindow {
+        pixels,
+        size: buffer_size,
+        geometry,
+        start: Instant::now(),
+        textures: Mutex::new(HashMap::new()),
+    })
+}
+
+impl State {
+    /// Copy a toplevel's last frame for its close animation. Call before the client's
+    /// buffer goes away: on a null commit, or when the toplevel is destroyed or unmapped.
+    pub fn start_close_animation(&mut self, surface: &WlSurface) {
+        if !enabled()
+            || !with_renderer_surface_state(surface, |state| state.buffer().is_some())
+                .unwrap_or(false)
+        {
+            return;
+        }
+
+        let (mapped, geometry, scale, handle) = {
+            let shell = self.common.shell.read();
+            // ponytail: a tab closing inside a stack is not animated.
+            let Some(mapped) = shell
+                .element_for_surface(surface)
+                .filter(|m| m.is_window())
+                .cloned()
+            else {
+                return;
+            };
+            let Some(workspace) = shell.space_for(&mapped) else {
+                return;
+            };
+            let Some(geometry) = workspace.element_geometry(&mapped) else {
+                return;
+            };
+            let scale = workspace.output.current_scale().fractional_scale();
+            (mapped, geometry, scale, workspace.handle)
+        };
+
+        let res = self
+            .backend
+            .offscreen_renderer(|kms| {
+                advertised_node_for_surface(surface, &self.common.display_handle)
+                    .or(*kms.primary_node.read().unwrap())
+            })
+            .context("No renderer")
+            .and_then(|renderer| match renderer {
+                RendererRef::Glow(renderer) => snapshot(renderer, &mapped, geometry, scale),
+                RendererRef::GlMulti(mut renderer) => {
+                    snapshot(&mut renderer, &mapped, geometry, scale)
+                }
+            });
+        match res {
+            Ok(closing) => {
+                if let Some(workspace) = self
+                    .common
+                    .shell
+                    .write()
+                    .workspaces
+                    .space_for_handle_mut(&handle)
+                {
+                    workspace.closing.push(closing);
+                }
+            }
+            Err(err) => warn!(?err, "Failed to copy closing window"),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn scale_rect_keeps_centre() {
+        let r: Rectangle<f64, Local> = Rectangle::new((100.0, 50.0).into(), (200.0, 100.0).into());
+        let s = scale_rect(r, 0.5);
+        assert_eq!((s.loc.x, s.loc.y, s.size.w, s.size.h), (150.0, 75.0, 100.0, 50.0));
+        assert_eq!(scale_rect(r, 1.0), r);
+    }
+
+    #[test]
+    fn progress_ends() {
+        let start = Instant::now() - CLOSE_DURATION;
+        assert!(progress(start, CLOSE_DURATION).is_none());
+        let p = progress(Instant::now(), CLOSE_DURATION).unwrap();
+        assert!((0.0..0.1).contains(&p));
+    }
+}
