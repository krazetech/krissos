 };
@@ -50,8 +50,38 @@ use crate::{
     utils::prelude::*,
 };
 
-pub const OPEN_DURATION: Duration = Duration::from_millis(180);
-pub const CLOSE_DURATION: Duration = Duration::from_millis(150);
+const OPEN_BASE: Duration = Duration::from_millis(180);
+const CLOSE_BASE: Duration = Duration::from_millis(150);
+
+/// KrissOS: the window look from org.krissos.Look, set in KrissOS Settings > Personalise >
+/// Windows: `animation_speed` (2.0 is twice as fast) and `shadow` (0.0 none, 1.0 COSMIC's).
+/// Stored as f32 bits; read from the render loop, written by the config watcher.
+static SPEED: AtomicU32 = AtomicU32::new(0x3f80_0000); // 1.0
+static SHADOW: AtomicU32 = AtomicU32::new(0x3f80_0000); // 1.0
+
+pub fn set_look(speed: f32, shadow: f32) -> bool {
+    let speed = if speed.is_finite() { speed.clamp(0.25, 4.0) } else { 1.0 };
+    let shadow = if shadow.is_finite() { shadow.clamp(0.0, 2.0) } else { 1.0 };
+    let a = SPEED.swap(speed.to_bits(), Ordering::Relaxed) != speed.to_bits();
+    let b = SHADOW.swap(shadow.to_bits(), Ordering::Relaxed) != shadow.to_bits();
+    a || b
+}
+
+pub fn shadow_strength() -> f32 {
+    f32::from_bits(SHADOW.load(Ordering::Relaxed))
+}
+
+fn speed() -> f32 {
+    f32::from_bits(SPEED.load(Ordering::Relaxed))
+}
+
+pub fn open_duration() -> Duration {
+    OPEN_BASE.div_f32(speed())
+}
+
+pub fn close_duration() -> Duration {
+    CLOSE_BASE.div_f32(speed())
+}
 /// Size a window opens from and closes to, as a fraction of its own.
 const MIN_SCALE: f64 = 0.94;
 
