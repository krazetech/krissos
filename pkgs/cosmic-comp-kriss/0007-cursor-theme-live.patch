@@ -711,7 +711,8 @@ impl Common {
             if xwayland
                 .xrdb_thread
                 .send((
-                    cosmic::icon_theme::default(),
+                    // KrissOS: the cursor theme here, not the icon theme.
+                    load_cursor_env().0,
                     (new_scale * cursor_size as f64).round() as u32,
                 ))
                 .is_err()
