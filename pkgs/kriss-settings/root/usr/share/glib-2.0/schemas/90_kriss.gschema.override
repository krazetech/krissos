[org.gnome.desktop.interface]
color-scheme='prefer-dark'
gtk-theme='{{gtk_theme}}'
icon-theme='{{icon_theme}}'
cursor-theme='{{cursor_theme}}'
font-name='{{font_sans}} 11'
document-font-name='{{font_sans}} 11'
monospace-font-name='{{font_mono}} 11'
# Smooth grey text like macOS, not coloured LCD fringes (fontconfig: 60-kriss.conf).
font-antialiasing='grayscale'
font-hinting='slight'

# Minimise, maximise and close on GTK apps that draw their own title bar (Firefox,
# GNOME apps), as on Windows. GNOME's default is close only.
[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'

# KDE's Ocean sounds (ocean-sound-theme, from kriss-theme); the shell keeps this in step
# with its own setting.
[org.gnome.desktop.sound]
theme-name='ocean'
event-sounds=true

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/kriss/sungai-petani-day.jpg'
picture-uri-dark='file:///usr/share/backgrounds/kriss/sungai-petani-night.jpg'
