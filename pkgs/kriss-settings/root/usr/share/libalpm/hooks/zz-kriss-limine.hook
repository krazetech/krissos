# Rewrite the Limine menu after kernel, initramfs or Limine updates; on legacy BIOS,
# kriss-limine-update also runs limine bios-install when Limine's boot code changed.
# Sorts before zz-kriss-sbctl.hook, so the files are final before they are signed.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/initcpio/*
Target = usr/share/limine/*

[Action]
Description = Updating the Limine boot menu...
When = PostTransaction
Exec = /usr/bin/kriss-limine-update
