# mkinitcpio runs this after it writes an image. With Secure Boot set up, limine.conf
# carries each initramfs's hash, so a rebuilt one (even `mkinitcpio -P` by hand) must be
# hashed again or Limine refuses to boot it.
exec /usr/bin/kriss-limine-update
