// KrissOS default for fastfetch: the emblem in the KrissOS colours.
// Your own ~/.config/fastfetch/config.jsonc replaces this file.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/kriss/fastfetch-logo.txt",
    "color": { "1": "{{accent.ansi}}", "2": "{{bg.ansi}}" },
    "padding": { "right": 3 }
  },
  "display": {
    "color": { "keys": "{{accent.ansi}}", "title": "{{accent.ansi}}" },
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    { "type": "disk", "folders": "/" },
    "break",
    "colors"
  ]
}
