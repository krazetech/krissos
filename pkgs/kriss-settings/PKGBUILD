# Maintainer: Kraze Tech
pkgname=kriss-settings
pkgver=0.4.6
pkgrel=1
pkgdesc='KrissOS default configs (Plasma, SDDM, GTK, Flatpak, terminals, prompt, fastfetch), os-release, Limine menu and pacman hooks'
arch=('any')
url='https://github.com/krazetech/krissos'
license=('GPL-3.0-or-later')
# plymouth is the boot splash: kriss-plymouth.hook makes kriss its theme and the
# installer puts its hook in the initramfs. snap-pac provides the snapper pre/post
# snapshot hooks; it skips them when snapper has no config.
depends=('diffutils' 'gsettings-desktop-schemas' 'snap-pac' 'fastfetch' 'plymouth')
makedepends=('python')
optdepends=('limine: the boot menu with bootable snapshots (kriss-limine-update)'
            'sbctl: re-sign the kernel and bootloader for Secure Boot')

# ponytail: the qt6ct config only takes effect with QT_QPA_PLATFORMTHEME=qt6ct. That is
# left to the KrissOS Shell session; setting it globally would break Plasma's Qt theming.

# root/ mirrors the installed filesystem. Font and theme names come from
# theme/tokens.json, so it goes through the same generator as kriss-theme.
_theme="$startdir/../../theme"

build() {
  python "$_theme/generate.py" "$startdir/root" "$srcdir/root"
  python "$_theme/generate.py" "$_theme/templates/usr/share/color-schemes" "$srcdir/colors"
  cat "$srcdir/colors/KrissOS.colors" >> "$srcdir/root/etc/xdg/kdeglobals"
  # The GTK colours go into ~/.config/gtk-*/gtk.css as they are, not as an @import of
  # /usr/share: Flatpak apps see the host's ~/.config/gtk-* (var/lib/flatpak/overrides)
  # but not its /usr.
  python "$_theme/generate.py" "$_theme/templates/usr/share/kriss/theme" "$srcdir/kriss"
  local v
  for v in 3 4; do
    install -m644 "$srcdir/kriss/gtk.css" "$srcdir/root/etc/skel/.config/gtk-$v.0/gtk.css"
  done
}

package() {
  # ponytail: kriss-theme is added here, not in the global array, because CI builds each
  # directory alone and `makepkg --syncdeps` cannot resolve [kriss] packages yet. Move it
  # up once pkgs.yml installs sibling packages before building.
  depends+=('kriss-theme')
  cp -r --no-preserve=ownership "$srcdir/root/." "$pkgdir/"
}
