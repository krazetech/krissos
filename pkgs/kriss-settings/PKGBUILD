# Maintainer: Kraze Tech
pkgname=kriss-settings
pkgver=0.5.3
pkgrel=1
pkgdesc='KrissOS default configs (Plasma, SDDM, GTK, Flatpak, terminals, prompt, fastfetch, input methods, printing), os-release, Limine menu and pacman hooks'
arch=('any')
url='https://github.com/krazetech/krissos'
license=('GPL-3.0-or-later')
# plymouth is the boot splash: kriss-plymouth.hook makes kriss its theme and the
# installer puts its hook in the initramfs. snap-pac provides the snapper pre/post
# snapshot hooks; it skips them when snapper has no config.
depends=('diffutils' 'gsettings-desktop-schemas' 'snap-pac' 'fastfetch' 'plymouth' 'binutils'
         # Typing in Malaysia's languages (etc/xdg/fcitx5): fcitx5 with its Qt and GTK modules
         # for apps that fall back to them, Pinyin, Tamil through m17n, and the CJK font
         # the Pinyin candidates need (noto-fonts already has Tamil and Arabic). Jawi is an
         # xkeyboard-config layout, my(phonetic), so it needs nothing more.
         'fcitx5' 'fcitx5-qt' 'fcitx5-gtk' 'fcitx5-chinese-addons' 'fcitx5-m17n' 'm17n-db'
         'adobe-source-han-sans-cn-fonts'
         # Printing (Settings > Printers): CUPS, started on demand by cups.socket, and
         # cups-browsed finding printers on the network through Avahi (DNS-SD only, see
         # cups-browsed.service.d/kriss.conf). cupsd listens on localhost:631 and its socket only.
         'cups' 'cups-browsed' 'avahi')
makedepends=('python')
optdepends=('fcitx5-osk: the on-screen keyboard on touch screens (its KrissOS themes are here)'
            'limine: the boot menu with bootable snapshots (kriss-limine-update)'
            'sbctl: re-sign the kernel and bootloader for Secure Boot'
            'shim-signed: start Limine with Secure Boot on and the stock keys (kriss-secureboot)'
            "mokutil: enroll this PC's key in shim's MOK list (kriss-secureboot)")

# ponytail: the qt6ct config only takes effect with QT_QPA_PLATFORMTHEME=qt6ct. That is
# left to the KrissOS Shell session; setting it globally would break Plasma's Qt theming.

# root/ mirrors the installed filesystem. Font and theme names come from
# theme/tokens.json, so it goes through the same generator as kriss-theme.
_theme="$startdir/../../theme"

build() {
  python "$_theme/generate.py" "$startdir/root" "$srcdir/root"
  python "$_theme/generate.py" "$_theme/templates/usr/share/color-schemes" "$srcdir/colors"
  cat "$srcdir/colors/KrissOS.colors" >> "$srcdir/root/etc/xdg/kdeglobals"
  # The GTK colours go into ~/.config/gtk-*/gtk.css as they are, not as an @import of
  # /usr/share: Flatpak apps see the host's ~/.config/gtk-* (var/lib/flatpak/overrides)
  # but not its /usr.
  python "$_theme/generate.py" "$_theme/templates/usr/share/kriss/theme" "$srcdir/kriss"
  local v
  for v in 3 4; do
    install -m644 "$srcdir/kriss/gtk.css" "$srcdir/root/etc/skel/.config/gtk-$v.0/gtk.css"
  done
}

package() {
  # ponytail: kriss-theme is added here, not in the global array, because CI builds each
  # directory alone and `makepkg --syncdeps` cannot resolve [kriss] packages yet. Move it
  # up once pkgs.yml installs sibling packages before building.
  depends+=('kriss-theme')
  cp -r --no-preserve=ownership "$srcdir/root/." "$pkgdir/"
  # Printing on for everyone, new installs and updates alike: CUPS on demand through its
  # socket (never cups.service at boot), Avahi for DNS-SD, and cups-browsed (see its drop-in).
  local units="$pkgdir/usr/lib/systemd/system"
  install -d "$units/sockets.target.wants" "$units/multi-user.target.wants"
  ln -s ../cups.socket "$units/sockets.target.wants/cups.socket"
  ln -s ../avahi-daemon.socket "$units/sockets.target.wants/avahi-daemon.socket"
  ln -s ../cups-browsed.service "$units/multi-user.target.wants/cups-browsed.service"
}
