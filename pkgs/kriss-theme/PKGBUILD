# Maintainer: Kraze Tech
pkgname=kriss-theme
pkgver=0.5.1
pkgrel=1
pkgdesc='KrissOS colours, fonts, wallpaper, Plasma, SDDM, Plymouth and Limine theme'
arch=('any')
url='https://github.com/krazetech/krissos'
license=('GPL-3.0-or-later' 'Apache-2.0')
# The lock clock's fonts: Inter Display (inter-font), Nunito, IBM Plex Sans Condensed and
# Noto Serif Display, all under the OFL.
depends=('adw-gtk-theme' 'vimix-cursors' 'papirus-icon-theme' 'qt6ct' 'inter-font' 'ttf-jetbrains-mono'
         'ttf-nunito' 'ttf-ibm-plex' 'noto-fonts')
makedepends=('python' 'librsvg')
optdepends=('python-onnxruntime-cpu: the lock clock depth effect on your own pictures (kriss-wallpaper-mask)'
            'python-numpy: the same'
            'python-pillow: the same'
'plymouth: boot splash'
            'limine: boot menu'
            'plasma-desktop: the KrissOS Plasma colour scheme and global theme'
            'sddm: the KrissOS login screen background')

# Sources live in this monorepo: every file is rendered from theme/tokens.json.
_theme="$startdir/../../theme"
# u2netp (U-2-Net's small model, Apache-2.0, by Xuebin Qin et al.) in ONNX form, as rembg
# publishes it: kriss-wallpaper-mask finds a wallpaper's subject with it, on the PC, offline.
source=("u2netp.onnx::https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2netp.onnx")
sha256sums=('309c8469258dda742793dce0ebea8e6dd393174f89934733ecc8b14c76f4ddd8')
noextract=('u2netp.onnx')

build() {
  python "$_theme/generate.py" "$_theme/templates" "$srcdir/root"
  # Plymouth cannot load SVG: generate.py writes the boot splash layers as SVG at
  # their final sizes, and each becomes a PNG here.
  local svg
  for svg in "$srcdir/root/usr/share/plymouth/themes/kriss/"*.svg; do
    rsvg-convert -o "${svg%.svg}.png" "$svg"
    rm "$svg"
  done
  # The Limine menu background. Limine cannot load SVG, and scaling an image to the
  # screen costs it about 38 s on a 2560x1440 PC, so it gets one PNG per common screen
  # size, centred. kriss-limine-update copies only the matching one to the ESP (Windows'
  # ESP is 100 MB); limine-wallpaper.png (1920x1080) is for any other size.
  local size lw="$srcdir/root/usr/share/kriss/theme/limine-wallpaper"
  rsvg-convert -w 1920 -h 1080 -o "$lw.png" "$srcdir/root/usr/share/backgrounds/kriss/kriss-dark.svg"
  for size in 1366x768 1600x900 1920x1080 1920x1200 2560x1080 2560x1440 2560x1600 3440x1440 3840x2160; do
    sed "s/width=\"3840\" height=\"2160\"/width=\"${size%x*}\" height=\"${size#*x}\"/" \
      "$srcdir/root/usr/share/backgrounds/kriss/kriss-dark.svg" | rsvg-convert -o "$lw-$size.png"
  done

  # Plasma picks the closest WxH.png and switches images/ <-> images_dark/ with the
  # colour scheme. The SVGs crop to fill (preserveAspectRatio slice), so setting
  # the root size renders the right crop for each aspect ratio.
  local bg="$srcdir/root/usr/share/backgrounds/kriss"
  local wp="$srcdir/root/usr/share/wallpapers/KrissOS/contents"
  local mode dir
  for mode in light dark; do
    dir=images; [[ $mode = dark ]] && dir=images_dark
    install -d "$wp/$dir"
    for size in 1920x1080 1920x1200 2560x1440 2560x1600 3840x2160; do
      sed "s/width=\"3840\" height=\"2160\"/width=\"${size%x*}\" height=\"${size#*x}\"/" \
        "$bg/kriss-$mode.svg" | rsvg-convert -o "$wp/$dir/$size.png"
    done
  done
}

check() {
  python "$_theme/generate.py" --test
}

package() {
  cp -r --no-preserve=ownership "$srcdir/root/." "$pkgdir/"
  install -d "$pkgdir/usr/share/fontconfig/conf.default"
  ln -s ../conf.avail/60-kriss.conf "$pkgdir/usr/share/fontconfig/conf.default/"
  # ponytail: old name of the dark wallpaper; drop once nothing points at it.
  ln -s kriss-dark.svg "$pkgdir/usr/share/backgrounds/kriss/default.svg"
  # The scene's subject (the keris) for the lock clock's depth effect, made once with
  # kriss-wallpaper-mask: onnxruntime is not packaged for aarch64, so no build runs it.
  # Every light of the scene and the plain wallpapers share the one composition.
  install -Dm644 "$_theme/kriss-scene.mask.png" "$pkgdir/usr/share/backgrounds/kriss/kriss-scene.mask.png"
  install -Dm755 "$_theme/kriss-wallpaper-mask" "$pkgdir/usr/bin/kriss-wallpaper-mask"
  install -Dm644 "$srcdir/u2netp.onnx" "$pkgdir/usr/share/kriss/models/u2netp.onnx"
  install -d "$pkgdir/usr/share/licenses/kriss-theme"
  printf '%s\n' "u2netp.onnx: U-2-Net (https://github.com/xuebinqin/U-2-Net), Apache-2.0," \
    "converted to ONNX by rembg (https://github.com/danielgatis/rembg)." \
    > "$pkgdir/usr/share/licenses/kriss-theme/u2netp"
}
