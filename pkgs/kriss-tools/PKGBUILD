# Maintainer: Kraze Tech
pkgname=kriss-tools
pkgver=0.2.0
pkgrel=2
pkgdesc='KrissOS system tools'
arch=('any')
url='https://github.com/krazetech/krissos'
license=('GPL-3.0-or-later')
depends=('bash' 'coreutils' 'glibc' 'grep' 'sed')
optdepends=('power-profiles-daemon: show and set the power profile (kriss tune)'
            'scx-tools: sched_ext scheduler per profile (kriss tune)')

# Sources live in this monorepo, so package straight from tools/.
package() {
  local t="$startdir/../../tools"
  install -Dm755 "$t/kriss" "$pkgdir/usr/bin/kriss"
  install -Dm644 "$t/kriss-tune.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-kriss-tune.rules"
  install -Dm644 "$t/kriss-tune.desktop" "$pkgdir/etc/xdg/autostart/kriss-tune.desktop"
}
