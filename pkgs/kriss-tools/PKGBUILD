# Maintainer: Kraze Tech
pkgname=kriss-tools
pkgver=0.9.1
pkgrel=1
pkgdesc='KrissOS system tools'
arch=('any')
url='https://github.com/krazetech/krissos'
license=('GPL-3.0-or-later')
depends=('bash' 'coreutils' 'curl' 'gawk' 'git' 'glibc' 'grep' 'jq' 'libnotify' 'pacman' 'pacman-contrib' 'polkit' 'polkit-kde-agent' 'sed' 'sudo' 'util-linux')
optdepends=('power-profiles-daemon: show and set the power profile (kriss tune)'
            'scx-tools: sched_ext scheduler per profile (kriss tune)'
            'snapper: snapshot before kriss update'
            'btrfs-progs: kriss rollback'
            'flatpak: Flathub apps in kriss search, install, remove and update'
            'base-devel: build AUR packages (kriss install adds it on the first AUR build)'
            'qemu-desktop: run the GPU passthrough VM (kriss-vm)'
            'libvirt: manage the passthrough VM (kriss-vm)'
            'edk2-ovmf: UEFI firmware for the passthrough VM (kriss-vm)'
            'looking-glass: show the passthrough VM on the host (kriss-vm)'
            'psmisc: kriss-vm bind checks nothing is using the GPU')

# Sources live in this monorepo, so package straight from tools/.
package() {
  local t="$startdir/../../tools" units="$pkgdir/usr/lib/systemd/user"
  install -Dm755 "$t/kriss" "$pkgdir/usr/bin/kriss"
  install -Dm755 "$t/kriss-vm" "$pkgdir/usr/bin/kriss-vm"
  install -Dm755 "$t/kriss-migrate" "$pkgdir/usr/bin/kriss-migrate"
  install -Dm644 "$t/org.krissos.kriss.policy" "$pkgdir/usr/share/polkit-1/actions/org.krissos.kriss.policy"
  install -Dm644 "$t/kriss-tune.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-kriss-tune.rules"
  install -Dm644 "$t/kriss-tune.desktop" "$pkgdir/etc/xdg/autostart/kriss-tune.desktop"
  # Says so at login when a boot-menu snapshot is running (kriss rollback --notice).
  install -Dm644 "$t/kriss-snapshot-notice.desktop" "$pkgdir/etc/xdg/autostart/kriss-snapshot-notice.desktop"
  install -Dm755 "$t/kriss-update-notify" "$pkgdir/usr/bin/kriss-update-notify"
  install -Dm644 -t "$units" "$t"/systemd/kriss-update-notify.{service,timer}
  # On for every user, like `systemctl --global enable`; `systemctl --user mask` turns it off.
  install -d "$units/timers.target.wants"
  ln -s ../kriss-update-notify.timer "$units/timers.target.wants/kriss-update-notify.timer"
  # The KrissOS Shell has no polkit agent of its own; without one pkexec and udisks cannot ask.
  # Started with the shell's session only, so other desktops on the same PC keep their own.
  install -Dm644 -t "$units" "$t"/systemd/kriss-polkit-agent.service
  install -d "$units/kriss-shell-session.target.wants"
  ln -s ../kriss-polkit-agent.service "$units/kriss-shell-session.target.wants/kriss-polkit-agent.service"
  # kriss reset finishes at the next boot, before the login screen.
  local sys="$pkgdir/usr/lib/systemd/system"
  install -Dm644 -t "$sys" "$t"/systemd/kriss-reset.service
  install -d "$sys/multi-user.target.wants"
  ln -s ../kriss-reset.service "$sys/multi-user.target.wants/kriss-reset.service"
}
