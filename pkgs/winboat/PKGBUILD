# Maintainer: Kraze Tech
# WinBoat is only in the AUR. We repack upstream's release .deb, pinned by checksum,
# so kriss-meta-winapps can depend on it from [kriss] without an AUR helper.
# ponytail: a binary repack, not a source build. Electron from source is an hour of CI
# for no patch of ours; build from source only if we ever need to patch it.
# Bump: set pkgver, then the sha256 from the release asset's digest on GitHub.
pkgname=winboat
pkgver=0.9.2
pkgrel=1
pkgdesc='Run Windows apps on Linux in a container, as native windows over RDP'
arch=('x86_64')
url='https://www.winboat.app'
license=('MIT')
depends=('alsa-lib' 'freerdp' 'gtk3' 'nss')
optdepends=('podman-compose: Podman runtime (kriss-meta-winapps installs it)'
            'docker-compose: Docker runtime')
options=('!strip' '!debug')
source=("https://github.com/TibixDev/winboat/releases/download/v$pkgver/winboat-$pkgver-amd64.deb")
sha256sums=('c01bfbabef6c1c57895dfb3165d4ca7c6912d2f63c67f61b2c2dd3e69449f0ba')

prepare() {
  bsdtar -xf data.tar.xz
}

package() {
  cp -r --preserve=mode,timestamps opt usr "$pkgdir/"
  # The .deb makes this link in its postinst. Arch kernels allow user namespaces,
  # so chrome-sandbox needs no setuid bit.
  install -d "$pkgdir/usr/bin"
  ln -s /opt/winboat/winboat "$pkgdir/usr/bin/winboat"
  install -Dm644 "$pkgdir/opt/winboat/LICENSE.electron.txt" -t "$pkgdir/usr/share/licenses/$pkgname"
}
