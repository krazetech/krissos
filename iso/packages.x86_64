# Kernel: baseline x86-64, so the live system boots on CPUs without x86-64-v3.
linux-kriss-generic
linux-kriss-generic-headers

# Live boot
base
mkinitcpio
mkinitcpio-archiso
syslinux
memtest86+
memtest86+-efi
amd-ucode
intel-ucode
linux-firmware
sof-firmware

# KrissOS
kriss-keyring
kriss-settings
kriss-theme
# The lock clock's depth effect on your own pictures, like a phone's: kriss-wallpaper-mask
# runs kriss-theme's model with it. x86 only, so kriss-theme keeps it optional for aarch64.
python-onnxruntime-cpu
python-pillow
kriss-tools
kriss-welcome
kriss-store

# Installer: Calamares with the KrissOS sequence. os-prober finds Windows, ntfs-3g
# resizes it. The installer copies this live system to the disk (no internet), so
# everything an installed KrissOS needs is listed here too.
calamares
kriss-installer
os-prober
ntfs-3g

# KrissOS Shell on cosmic-comp, with the KrissOS login screen on greetd
kriss-shell
cosmic-comp-kriss
greetd
cosmic-files
cosmic-terminal
cosmic-settings-kriss
xdg-desktop-portal-cosmic
power-profiles-daemon
upower
libnotify
firefox
noto-fonts
noto-fonts-emoji
# Typing in Chinese (Pinyin), Tamil and Jawi: fcitx5, set up by kriss-settings.
# fcitx5-kriss is fcitx5 with the modifier fix the on-screen keyboard needs.
fcitx5-kriss
fcitx5-osk
fcitx5-qt
fcitx5-gtk
fcitx5-chinese-addons
fcitx5-m17n
m17n-db
adobe-source-han-sans-cn-fonts
pipewire
pipewire-alsa
pipewire-pulse
wireplumber

# System
networkmanager
bluez
sudo
nano
man-db
inetutils
arch-install-scripts
btrfs-progs
dosfstools
e2fsprogs
exfatprogs
gptfdisk
efibootmgr
limine
shim-signed
mokutil
sbctl
binutils
snapper
snap-pac
zram-generator
bluez-utils
flatpak

# Graphics and Wi-Fi on any PC (small; the disk stays portable between machines). Mesa
# already carries the VA-API driver for AMD and nouveau.
vulkan-intel
vulkan-radeon
vulkan-nouveau
intel-media-driver
wireless-regdb

# NVIDIA's open driver for Turing and newer, also in the live session. The installer
# removes it from PCs without such a card; older cards keep nouveau.
dkms
nvidia-open-dkms
nvidia-utils
