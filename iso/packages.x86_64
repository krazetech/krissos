# Kernel: iso/build.sh swaps these two lines for the [kriss] kernel.
linux
linux-headers

# Live boot
base
mkinitcpio
mkinitcpio-archiso
syslinux
memtest86+
memtest86+-efi
amd-ucode
intel-ucode
linux-firmware
sof-firmware

# KrissOS
kriss-keyring
kriss-settings
kriss-theme
kriss-tools
kriss-welcome

# Installer: Calamares with the KrissOS sequence. os-prober finds Windows, ntfs-3g
# resizes it. The installer copies this live system to the disk (no internet), so
# everything an installed KrissOS needs is listed here too.
calamares
kriss-installer
os-prober
ntfs-3g

# KrissOS Shell on cosmic-comp, with the KrissOS login screen on greetd
kriss-shell
greetd
cosmic-files
cosmic-terminal
cosmic-settings
xdg-desktop-portal-cosmic
power-profiles-daemon
upower
libnotify
firefox
noto-fonts
noto-fonts-emoji
pipewire
pipewire-alsa
pipewire-pulse
wireplumber

# System
networkmanager
bluez
sudo
nano
man-db
arch-install-scripts
btrfs-progs
dosfstools
e2fsprogs
exfatprogs
gptfdisk
efibootmgr
limine
snapper
snap-pac
zram-generator
bluez-utils
flatpak

# NVIDIA's open driver for Turing and newer, also in the live session. The installer
# removes it from PCs without such a card; older cards keep nouveau.
dkms
nvidia-open-dkms
nvidia-utils
