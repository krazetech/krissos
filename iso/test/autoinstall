# Scripted install for CI: what Calamares does for "Erase disk" with the KrissOS Shell,
# without the pages. It partitions /dev/vda like partition.conf and mount.conf, copies the
# live system like unpackfs.conf, runs the installer's own unlive, online and configure
# steps, and stands in for Calamares' fstab, locale and users jobs. iso/install-test.sh
# hands it to the live ISO through QEMU's fw_cfg and systemd.run=, with no network: the
# install must work offline. Under SeaBIOS (no /sys/firmware/efi) it lays the disk out as
# Calamares does on legacy BIOS: GPT without an ESP, Limine on the FAT /boot.
set -euxo pipefail

disk=/dev/vda t=/target
# kriss_test_luks=PASSPHRASE on the live command line: "Encrypt system" ticked, so / goes
# in LUKS2 as Calamares names it (luks-<uuid>) and KRISSBOOT stays plain (noEncrypt).
luks=$(sed -n 's/.*kriss_test_luks=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -d /sys/firmware/efi ]; then
  sgdisk -Z -n1:0:+512M -t1:ef00 -n2:0:+2G -t2:ea00 -n3:0:0 -t3:8304 "$disk"
  udevadm settle
  mkfs.fat -F32 -n EFI "${disk}1"
  efi=${disk}1 boot=${disk}2 rootdev=${disk}3
else
  sgdisk -Z -n1:0:+2G -t1:ea00 -n2:0:0 -t2:8304 "$disk"
  udevadm settle
  efi='' boot=${disk}1 rootdev=${disk}2
fi
mkfs.fat -F32 -n KRISSBOOT "$boot"
if [ -n "$luks" ]; then
  printf %s "$luks" | cryptsetup luksFormat --type luks2 --batch-mode "$rootdev" -
  luksuuid=$(cryptsetup luksUUID "$rootdev")
  printf %s "$luks" | cryptsetup open "$rootdev" "luks-$luksuuid" -
  rootdev=/dev/mapper/luks-$luksuuid
fi
mkfs.btrfs -f -L KrissOS "$rootdev"
mkdir -p "$t"
mount "$rootdev" "$t"
for s in @ @home @cache @log @snapshots; do btrfs subvolume create "$t/$s"; done
umount "$t"
o=noatime,compress=zstd:1
mount -o "$o,subvol=@" "$rootdev" "$t"
mkdir -p "$t"/{home,var/cache,var/log,.snapshots,boot}
mount -o "$o,subvol=@home" "$rootdev" "$t/home"
mount -o "$o,subvol=@cache" "$rootdev" "$t/var/cache"
mount -o "$o,subvol=@log" "$rootdev" "$t/var/log"
mount -o "$o,subvol=@snapshots" "$rootdev" "$t/.snapshots"
if [ -n "$efi" ]; then mkdir "$t/efi" && mount -o umask=0077 "$efi" "$t/efi"; fi
mount "$boot" "$t/boot"

# Calamares' unpackfs (sourcefs: file is an rsync of the mounted live image).
rsync -aHAX /run/archiso/airootfs/ "$t/"
# The NVIDIA driver was built for the ISO's kernel; this VM has no NVIDIA card.
ls "$t"/usr/lib/modules/*/updates/dkms/nvidia.ko*
/usr/lib/kriss-installer/unlive "$t"
[ -z "$(arch-chroot "$t" pacman -Qq nvidia-utils calamares 2>/dev/null)" ]
if grep -q '^live:' "$t/etc/passwd"; then exit 1; fi

# Calamares' machineid, fstab, locale and users jobs.
systemd-machine-id-setup --root="$t"
genfstab -U "$t" >>"$t/etc/fstab"
# Calamares' fstab job: with / encrypted and /boot plain, crypttab lists / with no key.
if [ -n "$luks" ]; then echo "luks-$luksuuid UUID=$luksuuid none" >>"$t/etc/crypttab"; fi
sed -i 's/^#en_US.UTF-8/en_US.UTF-8/' "$t/etc/locale.gen"
arch-chroot "$t" locale-gen
echo LANG=en_US.UTF-8 >"$t/etc/locale.conf"
echo krissos >"$t/etc/hostname"
arch-chroot "$t" useradd -m -G wheel -c 'KrissOS Test' kriss
echo kriss:kriss | arch-chroot "$t" chpasswd

# No network here, so this must say offline and change nothing.
/usr/lib/kriss-installer/online "$t" shell
/usr/lib/kriss-installer/configure "$t"
grep -q '^\[multilib\]$' "$t/etc/pacman.conf"
arch-chroot "$t" locale -a | grep -qi '^ms_my\.utf'
# The boot splash: plymouth after early KMS, `splash` on the command line, the KrissOS theme.
grep -q ' kriss-kms plymouth ' "$t/etc/mkinitcpio.conf.d/kriss.conf"
grep -qw splash "$t/etc/kernel/cmdline"
grep -qx 'Theme=kriss' "$t/etc/plymouth/plymouthd.conf"
# Encrypted: the encrypt hook before filesystems, cryptdevice= naming the LUKS partition.
if [ -n "$luks" ]; then
  grep -q ' block encrypt filesystems ' "$t/etc/mkinitcpio.conf.d/kriss.conf"
  grep -q "^cryptdevice=UUID=$luksuuid:luks-$luksuuid root=UUID=" "$t/etc/kernel/cmdline"
  for img in "$t"/boot/initramfs-*.img; do
    files=$(arch-chroot "$t" lsinitcpio "/boot/${img##*/}")
    grep -q 'hooks/encrypt$' <<<"$files"
  done
elif grep -q encrypt "$t/etc/mkinitcpio.conf.d/kriss.conf"; then
  exit 1
fi

# Serial console for the test boot, and one snapshot to prove the Snapshots menu.
sed -i 's/$/ console=ttyS0,115200 systemd.journald.forward_to_console=1/' "$t/etc/kernel/cmdline"
arch-chroot "$t" snapper --no-dbus -c root create -d 'install test'
arch-chroot "$t" kriss-limine-update
if [ -n "$efi" ]; then dir=$t/efi/EFI/limine base=EFI/limine; else dir=$t/boot/limine base=limine; fi
conf=$dir/limine.conf
cat "$conf" "$t/etc/fstab"
# The menu: themed, versioned kernel entries under KrissOS, the snapshot under Snapshots.
grep -q '^interface_branding: KrissOS' "$conf"
grep -q "^wallpaper: boot():/$base/kriss-wallpaper.png" "$conf"
test -s "$dir/kriss-wallpaper.png"
grep -q '^/+KrissOS' "$conf"
grep -Eq '^//linux-kriss[a-z-]* [0-9]+\.[0-9]+' "$conf"  # linux-kriss online, linux-kriss-generic from the USB offline
grep -Eq '^default_entry: KrissOS/linux-kriss[a-z-]* [0-9]' "$conf"
grep -q '^//Snapshots' "$conf"
grep -q '^    ///.* install test (#[0-9]*)$' "$conf"
grep -q 'subvol=@snapshots/[0-9]*/snapshot.* kriss_snapshot=1' "$conf"
if [ -n "$efi" ]; then
  cmp -s "$conf" "$t/efi/EFI/BOOT/limine.conf"
  # Microsoft-signed shim first, Limine (with the .sbat section shim wants) as grubx64.efi.
  for d in "$dir" "$t/efi/EFI/BOOT"; do
    cmp -s "$t/usr/share/shim-signed/shimx64.efi" "$d/BOOTX64.EFI"
    cmp -s "$t/usr/share/shim-signed/mmx64.efi" "$d/mmx64.efi"
    objdump -h "$d/grubx64.efi" | grep -q ' \.sbat '
  done
  # With Secure Boot on (iso/secureboot-test.sh): this PC's key, Limine signed with it,
  # every path in the menu hashed, and the key waiting for MokManager.
  if mokutil --sb-state | grep -q 'SecureBoot enabled'; then
    test -s "$t/var/lib/sbctl/keys/db/db.der"
    objdump -p "$dir/grubx64.efi" | awk '/Security Directory/ {s = $4} END {exit s ~ /^0*$/}'  # signed
    grep -Eq '^    path: guid\([^)]*\):/vmlinuz-[^#]*#[0-9a-f]{128}$' "$conf"
    mokutil --list-new | grep -qi fingerprint
    echo 'kriss-autoinstall: Secure Boot key queued for MokManager'
  fi
else
  # Limine's BIOS boot code: in the first sector (sgdisk left it zeroed), its stage 2 in
  # the BIOS boot partition configure added, and limine-bios.sys next to the menu.
  sgdisk -p "$disk"
  sgdisk -p "$disk" | grep -q 'EF02 *BIOSBOOT'
  [ "$(dd if="$disk" bs=440 count=1 status=none | tr -d '\0' | wc -c)" -gt 0 ]
  cmp -s "$t/usr/share/limine/limine-bios.sys" "$dir/limine-bios.sys"
fi
# One line, so install-test.sh can boot the snapshot entry from it.
echo "kriss-limine-conf: $(base64 -w0 "$conf")"
ls -lR "$t/boot" ${efi:+"$t/efi"}
umount -R "$t" || { fuser -vm "$t" || true; exit 1; }
if [ -n "$luks" ]; then cryptsetup close "luks-$luksuuid"; fi
echo 'kriss-autoinstall: done'
