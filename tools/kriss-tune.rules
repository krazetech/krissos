// kriss tune: let active local admins switch sched_ext schedulers without a password,
// the same way power-profiles-daemon already lets them switch power profiles.
polkit.addRule(function (action, subject) {
  if (action.id == "org.scx.loader.manage-schedulers" &&
      subject.local && subject.active && subject.isInGroup("wheel")) {
    return polkit.Result.YES;
  }
});
