set -euo pipefail

readonly KRISS_VERSION="0.5.3"
readonly OS_RELEASE="${KRISS_OS_RELEASE:-/etc/os-release}"
# Overridable so tests can point hwcheck and winapps at fixture trees.
readonly PROC="${KRISS_PROC:-/proc}" SYS="${KRISS_SYS:-/sys}" DEV="${KRISS_DEV:-/dev}" ETC="${KRISS_ETC:-/etc}"

die() { printf 'kriss: %s\n' "$*" >&2; exit 2; }

# os_field KEY [DEFAULT]: read a value from os-release without sourcing it.
os_field() {
  local value=""
  if [[ -r $OS_RELEASE ]]; then
    value=$(sed -n "s/^$1=//p" "$OS_RELEASE" | tr -d '"')
  fi
  printf '%s' "${value:-${2:-}}"
}

# The dynamic loader reports which x86-64 levels the CPU supports (glibc >= 2.33).
cpu_level() {
  local ld=/usr/lib/ld-linux-x86-64.so.2
  if [[ ! -x $ld ]]; then
    uname -m
  elif "$ld" --help 2>/dev/null | grep -q 'x86-64-v3 (supported'; then
    echo x86-64-v3
  else
    echo x86-64
  fi
}

row() { printf '  %-9s %s\n' "$1" "$2"; }

cmd_info() {
  row os "$(os_field PRETTY_NAME "$(uname -s)")"
  row kernel "$(uname -r) · $(cpu_level)"
  row desktop "${XDG_CURRENT_DESKTOP:-none}"
  if command -v powerprofilesctl >/dev/null; then
    row profile "$(powerprofilesctl get 2>/dev/null || echo unknown)"
  fi
}

# GPU vendors from the PCI ids of every DRM card, as a JSON array.
gpu_vendors() {
  local f out=""
  for f in "$SYS"/class/drm/card[0-9]*/device/vendor; do
    [[ -r $f ]] || continue
    case "$(cat "$f")" in
      0x10de) out+='"nvidia",' ;;
      0x1002) out+='"amd",' ;;
      0x8086) out+='"intel",' ;;
      *) out+='"other",' ;;
    esac
  done
  # ponytail: hybrid laptops expose one card per GPU; duplicates are dropped by sort -u.
  printf '[%s]' "$(tr ',' '\n' <<<"$out" | sed '/^$/d' | sort -u | paste -sd, -)"
}

# Hardware facts as JSON, read without root. kriss-welcome uses winboat_ok to decide whether
# to offer Windows apps in a VM (the name predates the move to WinPodX): about 16 GB RAM, CPU
# virtualisation, /dev/kvm and enough cores.
ram_mb() { echo $(($(sed -n 's/^MemTotal: *\([0-9]*\) kB/\1/p' "$PROC/meminfo") / 1024)); }
cpu_threads() { grep -c '^processor' "$PROC/cpuinfo" || true; }
# vmx (Intel VT-x) or svm (AMD-V); empty when the firmware has it off.
cpu_virt() { grep -m1 -ow 'vmx\|svm' "$PROC/cpuinfo" || true; }

# Dedicated graphics memory in MiB, largest GPU first; 0 when there is none (iGPUs share RAM).
# Lets kriss-welcome say which local AI models fit.
vram_mb() {
  local f n max=0
  if command -v nvidia-smi >/dev/null; then
    while read -r n; do
      if [[ $n =~ ^[0-9]+$ ]] && ((n > max)); then max=$n; fi
    done < <(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null || true)
  fi
  # amdgpu reports bytes; an APU shows only its small carve-out here, which welcome ignores.
  for f in "$SYS"/class/drm/card[0-9]*/device/mem_info_vram_total; do
    [[ -r $f ]] || continue
    n=$(($(cat "$f") / 1048576))
    if ((n > max)); then max=$n; fi
  done
  echo "$max"
}

cmd_hwcheck() {
  local ram_mb cores virt kvm=false ok=true reasons=""
  ram_mb=$(ram_mb) cores=$(cpu_threads) virt=$(cpu_virt)
  [[ -e $DEV/kvm ]] && kvm=true
  # ponytail: 14 GiB, because a 16 GB PC reports less after firmware and iGPU
  # reservations. 4 threads is what the Windows VM gets.
  ((ram_mb >= 14336)) || reasons+='"ram",'
  [[ -n $virt ]] || reasons+='"virt",'
  [[ $kvm == true ]] || reasons+='"kvm",'
  ((cores >= 4)) || reasons+='"cores",'
  [[ -z $reasons ]] || ok=false
  local legacy=false
  nvidia_legacy_gpu >/dev/null && legacy=true
  printf '{"ram_mb": %d, "cores": %d, "virt": "%s", "kvm": %s, "gpus": %s, "winboat_ok": %s, "reasons": [%s], "nvidia_legacy": %s, "vram_mb": %d}\n' \
    "$ram_mb" "$cores" "$virt" "$kvm" "$(gpu_vendors)" "$ok" "${reasons%,}" "$legacy" "$(vram_mb)"
}

# --- kriss nvidia: the NVIDIA 580 driver for GPUs older than Turing ----------------------
# The installer gives Turing and newer nvidia-open-dkms and leaves older GPUs on nouveau
# (installer/lib/nvidia). The 580 branch is the last for Maxwell, Pascal and Volta: device
# ids 0x1340 to 0x1df6 in its supported-gpus.json (pkgs/nvidia-580xx-utils/SOURCES.md).
# Optional and online only; nouveau stays when it is skipped.

# The PCI address of an NVIDIA GPU that needs the 580 driver; fails when there is none.
nvidia_legacy_gpu() {
  local dev id
  for dev in "$SYS"/bus/pci/devices/*; do
    [[ $(cat "$dev/vendor" 2>/dev/null) == 0x10de ]] || continue
    case $(cat "$dev/class") in 0x0300* | 0x0302*) ;; *) continue ;; esac
    id=$(cat "$dev/device")
    if ((id >= 0x1340 && id < 0x1e00)); then echo "${dev##*/}"; return 0; fi
  done
  return 1
}

# The PCI address of the GPU that drives the built-in screen, when it is not NVIDIA's:
# the iGPU of a hybrid laptop.
nvidia_igpu() {
  local dev
  for dev in "$SYS"/bus/pci/devices/*; do
    [[ $(cat "$dev/boot_vga" 2>/dev/null) == 1 && $(cat "$dev/vendor") != 0x10de ]] || continue
    echo "${dev##*/}"
    return 0
  done
  return 1
}

# Everything the driver needs apart from the packages, as root under $ETC. Safe to run twice.
nvidia_configure() {
  local f igpu
  # Keep nouveau out of the initramfs, as the installer does for nvidia-utils: the kms hook
  # loads it early and the NVIDIA driver must not race with it. nvidia-580xx-utils
  # blacklists nouveau for the rest of the boot.
  # The boot splash goes too: plymouth needs early KMS (installer/lib/configure).
  f=$ETC/mkinitcpio.conf.d/kriss.conf
  [[ ! -f $f ]] || sed -i -E '/^HOOKS=/ { s/ (kriss-)?kms( |\))/\2/; s/ plymouth( |\))/\1/; }' "$f"
  # The driver turns modeset on by default (an AUR patch); say it on the command line too,
  # so it holds if that patch ever goes.
  f=$ETC/kernel/cmdline
  if [[ -f $f ]]; then
    sed -i -E 's/ splash( |$)/\1/' "$f"
    grep -qw 'nvidia_drm.modeset=1' "$f" || sed -i '1s/$/ nvidia_drm.modeset=1/' "$f"
  fi

  igpu=$(nvidia_igpu) || return 0
  # Hybrid laptop: the compositor stays on the iGPU (ARCHITECTURE §5); apps use the NVIDIA
  # GPU through prime-run.
  # ponytail: no runtime power management setup. NVIDIA supports runtime D3 on Turing and
  # newer only; on an MX150 the driver reports "Runtime D3 status: Not supported" and the
  # card stays powered (about 2 W more at idle than nouveau, which lets it suspend).
  f=$ETC/environment
  touch "$f"
  sed -i '/^COSMIC_RENDER_DEVICE=/d' "$f"
  echo "COSMIC_RENDER_DEVICE=/dev/dri/by-path/pci-$igpu-render" >>"$f"
}

cmd_nvidia_check() {
  local gpu driver
  if ! gpu=$(nvidia_legacy_gpu); then
    echo "No NVIDIA GPU here needs the 580 driver."
    return 1
  fi
  driver=$(readlink "$SYS/bus/pci/devices/$gpu/driver" || echo none)
  echo "NVIDIA GPU $gpu ($(cat "$SYS/bus/pci/devices/$gpu/device")) can use the NVIDIA 580 driver."
  echo "Driver in use: ${driver##*/}"
  if pacman -T nvidia-580xx-dkms nvidia-580xx-utils >/dev/null 2>&1; then
    echo "The 580 driver is installed."
  else
    echo "Not installed; it keeps nouveau. Install it with: pkexec kriss nvidia setup (needs internet)"
  fi
}

cmd_nvidia_setup() {
  ((EUID == 0)) || die "run 'pkexec kriss nvidia setup': it installs packages."
  nvidia_legacy_gpu >/dev/null || die "no NVIDIA GPU here needs the 580 driver."
  local kernel pkgs
  kernel=$(<"/usr/lib/modules/$(uname -r)/pkgbase") || die "cannot tell which kernel package is running."
  pkgs=(nvidia-580xx-dkms nvidia-580xx-utils "$kernel-headers")
  if grep -q '^\[multilib\]' "$ETC/pacman.conf"; then pkgs+=(lib32-nvidia-580xx-utils); fi
  local igpu
  if igpu=$(nvidia_igpu); then
    # prime-run, and Vulkan for the iGPU with Mesa's device-select layer listing it first.
    # Without them every Vulkan app (GTK 4 included) lands on the NVIDIA GPU.
    pkgs+=(nvidia-prime vulkan-mesa-implicit-layers)
    case $(cat "$SYS/bus/pci/devices/$igpu/vendor") in
      0x8086) pkgs+=(vulkan-intel) ;;
      0x1002) pkgs+=(vulkan-radeon) ;;
    esac
  fi
  pacman -S --needed --noconfirm "${pkgs[@]}" || die "installing the driver failed. Nothing else was changed."
  nvidia_configure
  mkinitcpio -P
  if command -v kriss-limine-update >/dev/null; then kriss-limine-update; fi
  echo "kriss: done. Restart to start using the NVIDIA 580 driver."
}

cmd_nvidia() {
  case "${1:-check}" in
    check) cmd_nvidia_check ;;
    setup) cmd_nvidia_setup ;;
    *) die "unknown nvidia command '$1'. Use check or setup." ;;
  esac
}

# kriss tune [performance|balanced|powersave|kapcai|status|sync]
# A profile sets the power-profiles-daemon profile and starts a sched_ext scheduler
# through scx_loader (scx-tools). Both are D-Bus services guarded by polkit; kriss-tools
# ships a polkit rule so active admin users switch schedulers without a password.
# ponytail: governor and EPP are left to power-profiles-daemon, which sets EPP itself on
# amd-pstate and intel_pstate. Write sysfs here only if a driver it skips matters.
cmd_tune() {
  local p="${1:-status}" ppd sched mode
  case "$p" in
    status)
      row profile "$(powerprofilesctl get 2>/dev/null || echo unknown)"
      row sched "$(scxctl get 2>/dev/null || echo none)"
      return ;;
    # Run at login: the power profile survives a reboot, the scheduler does not.
    sync) p=$(powerprofilesctl get); [[ $p != power-saver ]] || p=powersave ;;
  esac
  case "$p" in
    performance) ppd=performance sched=lavd mode=gaming ;;
    balanced) ppd=balanced sched=bpfland mode=auto ;;
    powersave | kapcai) ppd=power-saver sched=lavd mode=powersave ;;
    *) die "unknown profile '$p'. Use performance, balanced, powersave or status." ;;
  esac
  command -v powerprofilesctl >/dev/null || die "tune needs power-profiles-daemon."
  powerprofilesctl set "$ppd"
  if command -v scxctl >/dev/null; then
    # switch also starts a scheduler when none is running.
    scxctl switch -s "$sched" -m "$mode"
  else
    echo "kriss: scx-tools is not installed; only the power profile was set." >&2
  fi
  printf 'kriss: %s (power: %s, scheduler: scx_%s %s)\n' "$p" "$ppd" "$sched" "$mode"
}

# Update everything, after a btrfs snapshot when snapper is set up, so a bad update rolls back
# from the boot menu. Runs as root: the update notice calls it through pkexec.
snapshot() { # DESCRIPTION
  if has_snapper; then
    snapper -c root create --cleanup-algorithm number --description "$1"
  fi
}

# A keyring older than the packages makes good packages fail their signature check
# ("invalid or corrupted package"), and pacman then upgrades nothing. Arch's fix is to update
# the keyrings first; the -Syu straight after keeps it from being a partial upgrade.
# --noconfirm answers yes to deleting a download that failed its checks, so one more try
# fetches it again; that also gets past a dropped connection.
update_system() {
  local keyrings=() k
  for k in archlinux-keyring kriss-keyring; do
    pacman -Q "$k" &>/dev/null && keyrings+=("$k")
  done
  ((${#keyrings[@]} == 0)) || pacman -Sy --noconfirm --needed "${keyrings[@]}" ||
    echo "kriss: could not update the keyrings first; trying the update anyway" >&2
  pacman -Syu --noconfirm && return
  echo "kriss: the update stopped; trying once more" >&2
  pacman -Syu --noconfirm ||
    die "the update did not finish. If this PC is offline, connect and run 'kriss update' again."
}

# pacman reads replaces= only from the first repo with the installed package's own name, and
# [kriss] comes after [extra], so -Syu keeps cosmic-settings although cosmic-settings-kriss
# replaces it. Swap those here. --ask 4 answers yes to removing the package being replaced.
replace_from_kriss() {
  local names=() new=()
  mapfile -t names < <(for r in kriss-testing kriss; do pacman -Slq "$r" 2>/dev/null; done | sort -u)
  ((${#names[@]})) || return 0
  mapfile -t new < <(pacman -Si -- "${names[@]}" 2>/dev/null | awk '
      /^Name / { name = $3 }
      /^Replaces / { for (i = 3; i <= NF; i++) if ($i != "None") { sub(/[<>=].*/, "", $i); print name, $i } }' |
    while read -r n old; do pacman -Q "$old" &>/dev/null && ! pacman -Q "$n" &>/dev/null && echo "$n"; done | sort -u)
  ((${#new[@]})) || return 0
  echo "kriss: switching to KrissOS's own ${new[*]}"
  pacman -S --noconfirm --ask 4 -- "${new[@]}" ||
    echo "kriss: could not switch to ${new[*]}; the next kriss update tries again" >&2
}

# Apps KrissOS added to every install after some PCs were set up: -Syu never installs a
# package nothing depends on. Each is offered once; one the user removes later stays removed.
readonly NEW_DEFAULTS=(kriss-store)
readonly DEFAULTS_SEEN=${KRISS_DEFAULTS_SEEN:-/var/lib/kriss/defaults-seen}
add_new_defaults() {
  local p add=()
  for p in "${NEW_DEFAULTS[@]}"; do
    grep -qx -- "$p" "$DEFAULTS_SEEN" 2>/dev/null || pacman -Q "$p" &>/dev/null || add+=("$p")
  done
  if ((${#add[@]})); then
    echo "kriss: adding ${add[*]}, now part of KrissOS"
    pacman -S --noconfirm --needed -- "${add[@]}" ||
      { echo "kriss: could not add ${add[*]}; the next kriss update tries again" >&2; return 0; }
  fi
  mkdir -p "${DEFAULTS_SEEN%/*}"
  printf '%s\n' "${NEW_DEFAULTS[@]}" >"$DEFAULTS_SEEN"
}

cmd_update() {
  ((EUID == 0)) || die "update needs root. Run: pkexec kriss update"
  snapshot 'before kriss update'
  update_system
  replace_from_kriss
  add_new_defaults
  if command -v flatpak >/dev/null; then
    flatpak update --noninteractive --assumeyes
  fi
  aur_update
}

# kriss channel [stable|testing]: which KrissOS repo this PC updates from.
#   stable   [kriss], the default: packages after they have been through testing.
#   testing  [kriss-testing] ahead of [kriss]: every merge to main, before it is promoted.
# Going back to stable downgrades what came from testing, after a snapshot, so the system
# matches [kriss] again. Arch's own repos are not touched.
# shellcheck disable=SC2016 # $arch is pacman's
readonly TESTING_SERVER='https://github.com/krazetech/krissos/releases/download/testing-$arch'

channel_now() { if grep -q '^\[kriss-testing\]' "$ETC/pacman.conf"; then echo testing; else echo stable; fi; }

cmd_channel() {
  local want=${1:-} conf=$ETC/pacman.conf new
  if [[ -z $want ]]; then channel_now; return; fi
  case $want in stable | testing) ;; *) die "unknown channel '$want'. Use stable or testing." ;; esac
  if [[ $want == "$(channel_now)" ]]; then echo "kriss: already on $want."; return; fi
  ((EUID == 0)) || exec sudo "$0" channel "$want"
  grep -q '^\[kriss\]' "$conf" || die "$conf has no [kriss] repo, so there is no channel to switch."
  if [[ $want == testing ]]; then
    new=$(awk -v srv="$TESTING_SERVER" '$0 == "[kriss]" && !done {
            print "[kriss-testing]"; print "# Added by kriss channel testing. kriss channel stable removes it."
            print "SigLevel = Required"; print "Server = " srv; print ""; done = 1 } 1' "$conf")
  else
    # The section runs from its header to the next one, comments and blank lines included.
    new=$(awk '/^\[/ { skip = ($0 == "[kriss-testing]") } !skip' "$conf")
  fi
  # Write in place, so the file keeps its owner and mode.
  printf '%s\n' "$new" >"$conf"
  if [[ $want == testing ]]; then
    echo "kriss: updates now include [kriss-testing]. Run kriss update to get them."
    echo "kriss: to go back, run: kriss channel stable"
  else
    echo "kriss: back on stable. Putting back the [kriss] versions of anything from testing."
    snapshot 'before kriss channel stable'
    # -uu allows the downgrades; pacman asks before it changes anything.
    pacman -Syuu
  fi
}

# kriss rollback: make the snapshot booted from the Limine menu (KrissOS > Snapshots) the
# system for good. It becomes @ again; the system it replaces is kept as @.old-DATE.
# Runs from the snapshot itself, so its kernel (kept under /boot/kriss/ by
# kriss-limine-update when it is older) goes back into /boot with it.
# kriss rollback --notice: at login, say so when a snapshot is running.
in_snapshot() { grep -qw kriss_snapshot=1 "$PROC/cmdline"; }

cmd_rollback() {
  if [[ ${1:-} == --notice ]]; then
    in_snapshot || return 0
    notify-send -a KrissOS -i krissos -u critical 'Running a snapshot' \
      'Changes are lost at reboot. To keep this snapshot as your system, run: kriss rollback'
    return
  fi
  in_snapshot || die "rollback starts from a snapshot. Reboot, pick one under KrissOS > Snapshots in the boot menu, then run kriss rollback."
  ((EUID == 0)) || exec sudo "$0" rollback "$@"
  local n top old ver base ok
  n=$(sed -n 's|.*subvol=@snapshots/\([0-9]*\)/snapshot.*|\1|p' "$PROC/cmdline")
  [[ -n $n ]] || die "cannot tell which snapshot is running."
  read -rp "Make snapshot $n your system? The current one is kept as a backup. [y/N] " ok
  [[ $ok == [yY]* ]] || return 1
  top=$(mktemp -d)
  mount -o subvolid=5 "$(findmnt -nvo SOURCE /.snapshots)" "$top"
  old=@.old-$(date +%Y%m%d-%H%M%S)
  btrfs subvolume snapshot "$top/@snapshots/$n/snapshot" "$top/@.new"
  mv "$top/@" "$top/$old"
  mv "$top/@.new" "$top/@"
  umount "$top" && rmdir "$top"
  while read -r ver base; do
    [[ -f /boot/kriss/$ver/vmlinuz-$base ]] || continue
    cp "/boot/kriss/$ver/vmlinuz-$base" "/boot/kriss/$ver/initramfs-$base.img" /boot/
  done < <(for f in /usr/lib/modules/*/pkgbase; do echo "$(basename "${f%/pkgbase}") $(<"$f")"; done)
  KRISS_ROLLBACK=1 kriss-limine-update
  printf 'kriss: snapshot %s is now your system. Reboot to start it.\n' "$n"
  printf 'kriss: the old system is kept as %s. Once you are happy, free its space with:\n' "$old"
  printf '  sudo mount -o subvolid=5 %s /mnt && sudo btrfs subvolume delete /mnt/%s && sudo umount /mnt\n' \
    "$(findmnt -nvo SOURCE /.snapshots)" "$old"
}

# kriss reset: Reset this PC, from the command line or the Settings app's Recovery page.
#   --keep-files   remove apps added since install and reset every account's settings;
#                  documents, pictures and other files in /home stay.
#   --everything   the same, but also delete everything in every home folder and forget
#                  saved Wi-Fi: the next boot is like the first one. Accounts and their
#                  passwords stay, so someone can still log in (there is no first-boot setup).
# It takes a snapshot first, so the system side can be undone from the boot menu, then
# finishes at the next boot before anyone logs in (kriss-reset.service runs --finish): moving
# or deleting files under a running session would let it write half its settings back.
# Works offline: nothing is downloaded. Exit codes: 0 done or scheduled, 1 not confirmed,
# 2 error.
readonly RESET_PENDING=${KRISS_RESET_PENDING:-/var/lib/kriss/reset-pending}
# What `pacman -Qqe` said at the end of the installer (installer/lib/configure).
readonly INSTALL_LIST=${KRISS_INSTALL_LIST:-/var/lib/kriss/install-packages}
readonly HOMES=${KRISS_HOMES:-/home}
# Kept in --keep-files: keys are not settings, and losing them locks people out of things.
readonly RESET_KEEP=(.ssh .gnupg)

reset_accounts() { # "NAME HOME" for each person's account (UID 1000-59999 with a home in /home)
  awk -F: -v h="$HOMES/" '$3 >= 1000 && $3 < 60000 && index($6, h) == 1 { print $1, $6 }' "$ETC/passwd"
}

# Apps installed since the installer finished, one per line. Without the installer's list
# (installs older than kriss reset) nothing is removed: guessing could take out the desktop.
# ponytail: [kriss] packages, kernels, drivers and firmware stay even when added later, as
# updates rename packages (cosmic-settings -> cosmic-settings-kriss) and kriss nvidia adds
# drivers; a reset should not leave the PC without a desktop or a display.
reset_added_apps() {
  [[ -r $INSTALL_LIST ]] || return 0
  local keep
  keep=$(pacman -Slq kriss kriss-testing 2>/dev/null | sort -u)
  comm -23 <(pacman -Qqe | sort) <(sort -u "$INSTALL_LIST") | comm -23 - <(printf '%s\n' "$keep") |
    grep -Ev '^(linux|nvidia|lib32-nvidia)|-firmware$|-ucode$|-keyring$' || true
}

reset_plan() { # reset_plan MODE: the plain-words list of what will happen
  local mode=$1 apps n
  apps=$(reset_added_apps)
  n=$(grep -c . <<<"$apps" || true)
  if [[ $mode == everything ]]; then
    echo "Reset this PC: remove everything"
  else
    echo "Reset this PC: keep my files"
  fi
  if has_snapper; then
    echo "  - Takes a snapshot first. To undo the system part, start 'before kriss reset' from the boot menu (KrissOS > Snapshots) and run kriss rollback."
  else
    echo "  - No snapshot: snapper is not set up here, so this cannot be undone."
  fi
  if [[ ! -r $INSTALL_LIST ]]; then
    echo "  - Keeps installed apps: this PC has no record of what the installer put on it."
  elif ((n == 0)); then
    echo "  - No apps were added since KrissOS was installed."
  else
    echo "  - Removes $n app(s) added since KrissOS was installed: $(paste -sd' ' - <<<"$apps")"
  fi
  if command -v flatpak >/dev/null; then echo "  - Removes Flatpak apps."; fi
  local name home
  while read -r name home; do
    if [[ $mode == everything ]]; then
      echo "  - DELETES everything in $home ($name): documents, pictures, music, videos, downloads, desktop and settings. This cannot be undone."
    else
      echo "  - Resets $name's settings. Files in $home stay; the old settings go to $home/old-settings-DATE."
    fi
  done < <(reset_accounts)
  if [[ $mode == everything ]]; then echo "  - Forgets saved Wi-Fi networks."; fi
  echo "  - Accounts and passwords stay. Finishes at the next restart, before anyone logs in."
}

reset_finish() { # at boot, as root: do what kriss reset scheduled
  [[ -f $RESET_PENDING ]] || return 0
  in_snapshot && { echo "kriss: a snapshot is running; the reset waits for the normal system."; return 0; }
  local mode stamp apps name home f
  read -r mode stamp <"$RESET_PENDING"
  # Gone first, so a reset that fails half way does not run again at every boot.
  rm -f "$RESET_PENDING"
  echo "kriss: resetting this PC ($mode)"
  apps=$(reset_added_apps)
  if [[ -n $apps ]]; then
    # shellcheck disable=SC2086 # one package per word
    pacman -Rns --noconfirm $apps || echo "kriss: some apps could not be removed" >&2
  fi
  if command -v flatpak >/dev/null; then
    flatpak uninstall --system --all --noninteractive || echo "kriss: some Flatpak apps could not be removed" >&2
  fi
  shopt -s nullglob dotglob
  while read -r name home; do
    [[ -d $home ]] || continue
    if [[ $mode == everything ]]; then
      find "$home" -mindepth 1 -delete
      cp -a "$ETC/skel/." "$home/"
      chown -R "$name:" "$home"
      echo "kriss: emptied $home"
    else
      local old=$home/old-settings-$stamp
      install -d -m 700 -o "$name" -g "$(id -gn "$name")" "$old"
      for f in "$home"/.*; do
        [[ " ${RESET_KEEP[*]} " == *" ${f##*/} "* ]] || mv -- "$f" "$old/"
      done
      cp -a "$ETC/skel/." "$home/"
      chown -R "$name:" "$home" 2>/dev/null || true
      chown -R "$name:" "$old"
      echo "kriss: $name's old settings are in $old"
    fi
  done < <(reset_accounts)
  shopt -u nullglob dotglob
  if [[ $mode == everything ]]; then rm -f "$ETC"/NetworkManager/system-connections/*; fi
  echo "kriss: reset done"
}

cmd_reset() {
  local mode='' yes=0 dry=0 a
  for a in "$@"; do
    case $a in
      --keep-files) mode='keep-files' ;;
      --everything) mode=everything ;;
      --yes | -y) yes=1 ;;
      --dry-run) dry=1 ;;
      --finish) ((EUID == 0)) || die "reset --finish needs root."; reset_finish; return ;;
      --cancel)
        [[ -f $RESET_PENDING ]] || { echo "kriss: no reset is waiting."; return 0; }
        ((EUID == 0)) || exec sudo "$0" reset --cancel
        rm -f "$RESET_PENDING"; echo "kriss: the reset will not happen."; return ;;
      *) die "unknown option '$a'. Run 'kriss help'." ;;
    esac
  done
  [[ -n $mode ]] || die "say what to reset: kriss reset --keep-files, or kriss reset --everything"
  if ((dry)); then reset_plan "$mode"; return 0; fi
  in_snapshot && die "a snapshot is running. Restart into the normal system first."
  ((EUID == 0)) || exec sudo "$0" reset "$@"
  reset_plan "$mode"
  if ((!yes)); then
    local word
    read -rp "Type RESET to go on, or press Enter to stop: " word || return 1
    [[ ${word,,} == reset ]] || { echo "kriss: nothing was changed."; return 1; }
  fi
  snapshot 'before kriss reset' || die "could not take the snapshot, so nothing was changed."
  # After the snapshot, so starting that snapshot from the boot menu does not reset again.
  mkdir -p "${RESET_PENDING%/*}"
  echo "$mode $(date +%Y%m%d-%H%M%S)" >"$RESET_PENDING"
  echo "kriss: the reset finishes at the next restart. To stop it before then: kriss reset --cancel"
  ((yes)) || ! ask "Restart now? [Y/n]" y || systemctl reboot
}

# kriss report: Report a problem, from the command line or the Settings app.
# Gathers what a bug report needs, takes out what is personal, shows all of it, and only then
# opens a prefilled GitHub issue in the browser, where nothing is sent until the user presses
# Submit. Offline, or with --save, it writes a file instead.
#   kriss report [WORDS]     show the report, ask, then open the issue (WORDS: its title)
#   kriss report --print     print the report only
#   kriss report --open      open the issue without asking (the Settings app asked already)
#   kriss report --save FILE write the report to FILE
# Exit codes: 0 opened or saved, 1 not confirmed, 2 error, 3 offline (saved to a file instead).
readonly ISSUE_URL=${KRISS_ISSUE_URL:-https://github.com/krazetech/krissos/issues/new}
readonly PACMAN_LOG=${KRISS_PACMAN_LOG:-/var/log/pacman.log}

# shellcheck disable=SC2016 # the backticks are Markdown
report_section() { printf '\n### %s\n```\n%s\n```\n' "$1" "$(cat)"; }

report_raw() {
  {
    echo "kriss $KRISS_VERSION, $(os_field PRETTY_NAME unknown)"
    echo "kernel $(uname -r) $(cpu_level), desktop ${XDG_CURRENT_DESKTOP:-none}, channel $(channel_now)"
  } | report_section 'Version'
  {
    local f
    for f in sys_vendor product_name product_version board_name bios_version; do
      [[ -r $SYS/class/dmi/id/$f ]] && printf '%s: %s\n' "$f" "$(<"$SYS/class/dmi/id/$f")"
    done
    sed -n 's/^model name\s*: //p' "$PROC/cpuinfo" | head -n1
    echo "RAM: $(ram_mb) MB"
  } | report_section 'Hardware'
  { lspci -nnk 2>/dev/null | grep -A3 -E 'VGA|3D|Display' || echo 'lspci not found'; } | report_section 'GPU and driver'
  { journalctl -b -p err -q --no-pager 2>/dev/null | tail -n 60 || true; } | report_section 'Errors since boot'
  { tail -n 40 "$PACMAN_LOG" 2>/dev/null || true; } | report_section 'Recent package changes'
  { journalctl -b -q --no-pager -t kriss-shell _COMM=qs 2>/dev/null | tail -n 40 || true; } | report_section 'Shell log'
}

# Literal strings that identify the person or the PC, one per line.
report_secrets() {
  awk -F: '$3 >= 1000 && $3 < 60000 { print $6; print $1 }' "$ETC/passwd"
  [[ -n ${USER:-} ]] && echo "$USER"
  cat "$ETC/hostname" 2>/dev/null || true
  if command -v nmcli >/dev/null; then nmcli -t -g NAME connection show 2>/dev/null || true; fi
  cat "$SYS"/class/dmi/id/{product_serial,board_serial,chassis_serial,product_uuid} 2>/dev/null || true
}

# Take out names, homes, Wi-Fi names, serial numbers, MAC and IP addresses and emails.
# ponytail: a word list plus patterns; anything personal that matches neither (a file name a
# user typed) still shows, which is why the user sees the whole report before it goes.
report_scrub() {
  local script='' w
  while IFS= read -r w; do
    ((${#w} >= 3)) || continue
    case $w in root | none | unknown | localhost | /home | /root) continue ;; esac
    script+="s/$(printf '%s' "$w" | sed 's/[][\.*^$/&]/\\&/g')/[removed]/g;"
  done < <(report_secrets | sort -u | awk '{ print length, $0 }' | sort -rn | cut -d' ' -f2-)
  sed -E "${script}"'s/([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}/[mac]/g; s/[0-9]{1,3}(\.[0-9]{1,3}){3}/[ip]/g; s/[[:alnum:]._%+-]+@[[:alnum:].-]+\.[a-z]{2,}/[email]/g'
}

cmd_report() {
  local mode=ask file='' title=()
  while (($#)); do
    case $1 in
      --print) mode=print ;;
      --open) mode=open ;;
      --save) mode=save file=${2:-}; [[ -n $file ]] || die "--save needs a file name."; shift ;;
      -*) die "unknown option '$1'. Run 'kriss help'." ;;
      *) title+=("$1") ;;
    esac
    shift
  done
  local report
  report=$(report_raw | report_scrub)
  if [[ $mode == print ]]; then printf '%s\n' "$report"; return 0; fi
  [[ -n $file ]] || file=${XDG_DOWNLOAD_DIR:-$HOME}/kriss-report-$(date +%Y%m%d-%H%M%S).md
  if [[ $mode == save ]]; then
    printf '%s\n' "$report" >"$file"; echo "kriss: saved the report to $file"; return 0
  fi
  if [[ $mode == ask ]]; then
    printf '%s\n\n' "$report"
    echo "This is everything that goes in the report. Names, Wi-Fi names, serial numbers and addresses are taken out."
    ask "Open it as a GitHub issue in your browser? Nothing is sent until you press Submit there. [y/N]" n ||
      { echo "kriss: nothing was sent."; return 1; }
  fi
  if ! curl -fsI --max-time 5 https://github.com >/dev/null 2>&1; then
    printf '%s\n' "$report" >"$file"
    echo "kriss: this PC is offline. The report is saved in $file; post it at $ISSUE_URL once you are online."
    return 3
  fi
  local body="**What happened, and what did you expect?**"$'\n\n\n'"$report"
  # Browsers and GitHub refuse very long links; the full report goes in a file to attach.
  if (($(uri "$body" | wc -c) > 7000)); then
    printf '%s\n' "$report" >"$file"
    body="**What happened, and what did you expect?**"$'\n\n\n'"The report is long: please drag $(basename "$file") here."$'\n'"$(head -c 3000 <<<"$report")"
    echo "kriss: the full report is saved in $file. Drag it into the issue."
  fi
  local url
  url="$ISSUE_URL?title=$(uri "${title[*]:-Problem report}")&labels=bug&body=$(uri "$body")"
  xdg-open "$url" >/dev/null 2>&1 || { echo "kriss: could not open a browser. Open this link:"; echo "$url"; }
  echo "kriss: the issue is open in your browser. Add what happened, then press Submit."
}

# kriss winapps check|setup|office: Windows apps in WinPodX (ARCHITECTURE §7, tier 1).
# check only reads. setup offers the fixes that are safe to make, asks before each one,
# then runs `winpodx setup`, which downloads Windows from Microsoft and installs it.
# WinPodX opens each Windows app as its own window with its own Start entry and file types.
WA_BAD=0 WA_FIX=()
wa_row() { # wa_row NAME ok|warn|FAIL MESSAGE [FIX]
  row "$1" "$2: $3"
  [[ $2 != FAIL ]] || WA_BAD=1
  if [[ -n ${4:-} ]]; then
    row "" "fix: $4"
    [[ " ${WA_FIX[*]} " == *" $4 "* ]] || WA_FIX+=("$4")
  fi
}

# The version in `--version` output such as "podman version 5.4.0" or "FreeRDP version 3.10.3".
wa_ver() { "$@" --version 2>/dev/null | grep -om1 'version [0-9][0-9.]*' | cut -d' ' -f2 || true; }

# A 65536-ID range past every range in the given subuid/subgid files, as START-END.
wa_free_range() {
  local start
  start=$(cat "$@" 2>/dev/null | awk -F: '$2+$3>m{m=$2+$3} END{print (m<100000?100000:m)}' || true)
  printf '%d-%d' "$start" $((start + 65535))
}

winapps_check() {
  local user virt mod v f gib rdp="" pkg="sudo pacman -S --needed kriss-meta-winapps"
  user=$(id -un)
  WA_BAD=0 WA_FIX=()
  printf 'kriss winapps check\n'

  virt=$(cpu_virt)
  if [[ -z $virt ]]; then
    wa_row cpu FAIL "virtualisation is off. Turn on SVM (AMD) or VT-x (Intel) in your firmware (BIOS) settings."
  else
    wa_row cpu ok "virtualisation flag $virt"
    mod=kvm_intel; [[ $virt == vmx ]] || mod=kvm_amd
    if [[ -d $SYS/module/$mod ]]; then wa_row module ok "$mod loaded"
    else wa_row module FAIL "the $mod kernel module is not loaded, so Linux cannot run VMs." "sudo modprobe $mod"; fi
  fi

  if [[ ! -e $DEV/kvm ]]; then
    wa_row kvm FAIL "/dev/kvm is missing. It appears once virtualisation is on and the KVM module is loaded."
  elif [[ -r $DEV/kvm && -w $DEV/kvm ]]; then
    wa_row kvm ok "/dev/kvm is usable by $user"
  elif id -nG "$user" | grep -qw kvm; then
    wa_row kvm FAIL "you are in the kvm group, but this login started before you joined. Log out and back in."
  else
    wa_row kvm FAIL "$user cannot open /dev/kvm. Joining the kvm group allows it (log out and back in after)." \
      "sudo gpasswd -a $user kvm"
  fi

  if ! command -v podman >/dev/null; then
    wa_row podman FAIL "Podman is not installed. WinPodX runs Windows inside a Podman container." "$pkg"
  else
    v=$(wa_ver podman)
    if [[ ${v%%.*} =~ ^[0-9]+$ ]] && ((${v%%.*} >= 4)); then wa_row podman ok "version $v"
    else wa_row podman FAIL "version ${v:-unknown} is too old; WinPodX needs 4 or newer." "$pkg"; fi
  fi
  if command -v podman-compose >/dev/null; then wa_row compose ok "podman-compose $(wa_ver podman-compose)"
  else wa_row compose FAIL "podman-compose is missing. WinPodX starts its container with it." "$pkg"; fi

  for f in xfreerdp3 xfreerdp; do
    command -v "$f" >/dev/null || continue
    v=$(wa_ver "$f")
    if [[ $v == 3.* ]]; then rdp="$f $v"; break; fi
  done
  if [[ -n $rdp ]]; then wa_row freerdp ok "$rdp"
  else wa_row freerdp FAIL "FreeRDP 3 is missing. WinPodX shows each Windows app as a window through it." "$pkg"; fi

  if command -v winpodx >/dev/null; then wa_row winpodx ok "installed"
  else wa_row winpodx FAIL "WinPodX is not installed." "$pkg"; fi

  # Rootless Podman maps the container's users onto a range of IDs this user owns.
  if grep -q "^$user:" "$ETC/subuid" 2>/dev/null && grep -q "^$user:" "$ETC/subgid" 2>/dev/null; then
    wa_row rootless ok "$user has subordinate user and group IDs"
  else
    v=$(wa_free_range "$ETC/subuid" "$ETC/subgid")
    wa_row rootless FAIL "$user has no subordinate IDs, so Podman cannot run containers as you." \
      "sudo usermod --add-subuids $v --add-subgids $v $user && podman system migrate"
  fi
  if [[ -e $SYS/fs/cgroup/cgroup.controllers ]]; then wa_row cgroups ok "v2"
  else wa_row cgroups FAIL "rootless Podman needs cgroup v2. Remove systemd.unified_cgroup_hierarchy=0 from the kernel command line."; fi

  # WinPodX publishes these on 127.0.0.1. Its agent (8765) and SMB (4445) ports are fixed; RDP
  # and VNC can move in its config. Skipped while its own container runs: it holds them then.
  if [[ $(podman inspect -f '{{.State.Running}}' winpodx-windows 2>/dev/null) != true ]]; then
    for f in 8765:agent 4445:SMB 3390:RDP 8007:VNC; do
      v=$(ss -Hltnp "sport = :${f%%:*}" 2>/dev/null | sed -n 1p)
      [[ -n $v ]] || continue
      # Best effort: ss names the process only when it belongs to this user.
      v=$(grep -o 'users:(("[^"]*' <<<"$v" | cut -d'"' -f2 || true)
      wa_row port FAIL "127.0.0.1:${f%%:*} is in use${v:+ by $v}. WinPodX needs it for its ${f#*:} connection; stop or move that program.$(
        case ${f#*:} in RDP) echo " Or move WinPodX's: winpodx config set rdp.port <free port>" ;;
          VNC) echo " Or move WinPodX's: winpodx config set pod.vnc_port <free port>" ;; esac)"
    done
  fi

  # Windows gets 4 GB RAM and 4 threads, and its disk image wants room to grow (WinPodX's
  # default disk is 64 GB, plus a ~7.5 GB ISO). Warnings only: it still runs on less.
  v=$(ram_mb)
  if ((v >= 14336)); then wa_row memory ok "$((v / 1024)) GiB"
  else wa_row memory warn "$((v / 1024)) GiB. Windows takes 4 GB of it, so Linux apps will feel tight."; fi
  v=$(cpu_threads)
  if ((v >= 4)); then wa_row threads ok "$v"; else wa_row threads warn "$v. Windows wants 4 or more."; fi
  gib=$(df -Pk "$HOME" | awk 'NR==2{print int($4/1048576)}')
  if ((gib >= 32)); then wa_row disk ok "$gib GiB free in $HOME"
  else wa_row disk warn "$gib GiB free in $HOME. Windows needs at least 32 GiB."; fi

  ((WA_BAD == 0))
}

# What WinPodX does to Windows that the user should know before saying yes. Their choice
# (2026-11-25): keep WinPodX's defaults and say so plainly.
winapps_disclose() {
  cat <<'EOF'
Before you go on, what WinPodX changes in Windows:
  - Windows normally allows one remote session per user, so a second app would take over
    the first one's window. WinPodX patches Windows (rdprrap, based on RDP Wrapper) so each
    app gets its own window. Microsoft's licence terms do not allow working around Windows'
    limits like this; the choice is yours. Turn it off any time:
      winpodx guest multi-session off
  - So Microsoft Defender leaves that patch and WinPodX's helpers alone, it tells Defender
    not to scan C:\OEM, C:\winpodx and C:\Users\Public\winpodx.
  - It hides from Windows that it is running in a virtual machine ("disguise", balanced).
    Turn it off with: winpodx config set pod.disguise_level off
  - Windows itself (about 7.5 GB) is downloaded from Microsoft.
EOF
}

cmd_winapps_setup() {
  ((EUID != 0)) || die "run 'kriss winapps setup' as yourself, not root: WinPodX runs Podman as your user."
  local f a relogin=0
  if ! winapps_check; then
    printf '\nSome pieces are missing. Each fix runs only if you answer y.\n'
    for f in "${WA_FIX[@]}"; do
      read -rp "Run '$f'? [y/N] " a || a=n
      [[ $a == [yY]* ]] || continue
      bash -c "$f" || die "that fix failed. Nothing after it was run."
      [[ $f != *gpasswd* ]] || relogin=1
    done
    if ((relogin)); then
      echo "kriss: log out and back in so the kvm group applies, then run 'kriss winapps setup' again."
      return 0
    fi
    echo
    winapps_check || die "not ready yet. Fix the FAIL lines above, then run 'kriss winapps setup' again."
  fi
  echo
  winapps_disclose
  read -rp "Set up Windows apps with WinPodX now? [y/N] " a || a=n
  [[ $a == [yY]* ]] || return 0
  winpodx setup
  wpx_icons
}

# kriss winapps office: Microsoft Office in WinPodX's Windows, downloaded from Microsoft
# when the user asks. KrissOS ships no Office files; the user signs in with their own
# Microsoft account or product key. WinPodX runs the installer as an app of our own and
# then finds Word, Excel and PowerPoint itself, with Start entries and file types.
# ponytail: Bottles/Wine is not offered; Microsoft 365 there still crashes and shows black
# windows (bottlesdevs/programs#500). Revisit when that issue is closed.
OFFICE_DIR=${HOME:-}/.local/share/kriss/office
WPX_DIR=${XDG_DATA_HOME:-${HOME:-}/.local/share}/winpodx
WPX_APPS=$WPX_DIR/apps
# Microsoft's own Office Deployment Tool (setup.exe), on Microsoft's CDN.
OFFICE_ODT=https://officecdn.microsoft.com/pr/wsus/setup.exe

# Point each WinPodX Start entry's Icon= at its file. WinPodX installs the icons into
# ~/.local/share/icons/hicolor while the shell is running, and Qt's icon theme cache misses
# files added after start, so the taskbar showed a generic icon until the next login.
wpx_icons() {
  local f name best dir=${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor
  for f in "${XDG_DATA_HOME:-$HOME/.local/share}"/applications/winpodx-*.desktop; do
    [[ -f $f ]] || continue
    name=$(sed -n 's/^Icon=//p' "$f")
    [[ -n $name && $name != /* ]] || continue
    for best in "$dir/scalable/apps/$name.svg" "$dir"/{512,256,128,96,64,48,32,24,16}x*/apps/"$name.png" ""; do
      [[ -f $best ]] && break
    done
    [[ -z $best ]] || sed -i "s|^Icon=.*|Icon=$best|" "$f"
  done
}

# Word, Excel and PowerPoint open their own Office formats and nothing else. WinPodX (with
# KrissOS's patch) gives discovered apps no file types, so this adds them as user-defined
# apps of WinPodX's, which survive its refreshes. Each becomes the default only for a type
# that has no explicit default yet. Records app=slug lines for the Store's Open button.
OFFICE_TYPES='WINWORD.EXE|application/msword;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.openxmlformats-officedocument.wordprocessingml.template;application/vnd.ms-word.document.macroEnabled.12;application/vnd.ms-word.template.macroEnabled.12
EXCEL.EXE|application/vnd.ms-excel;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.openxmlformats-officedocument.spreadsheetml.template;application/vnd.ms-excel.sheet.macroEnabled.12;application/vnd.ms-excel.template.macroEnabled.12;application/vnd.ms-excel.sheet.binary.macroEnabled.12
POWERPNT.EXE|application/vnd.ms-powerpoint;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.openxmlformats-officedocument.presentationml.slideshow;application/vnd.openxmlformats-officedocument.presentationml.template;application/vnd.ms-powerpoint.presentation.macroEnabled.12;application/vnd.ms-powerpoint.slideshow.macroEnabled.12'

# Whether MIME has an explicit default in the user's or the system's mimeapps.list.
has_default() {
  local f files=()
  for f in "${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list" "$ETC/xdg/mimeapps.list"; do
    [[ -r $f ]] && files+=("$f")
  done
  ((${#files[@]})) || return 1
  awk -v m="$1=" '/^\[/ { d = ($0 == "[Default Applications]") } d && index($0, m) == 1 { f = 1 } END { exit !f }' "${files[@]}"
}

office_types() {
  local exe mimes f slug m
  : >"$OFFICE_DIR/apps"
  while IFS='|' read -r exe mimes; do
    f=$(grep -lis "^executable = .*${exe}[\"']\$" "$WPX_DIR"/discovered/*/app.toml | sed -n 1p || true)
    [[ -n $f ]] || continue
    slug=${f%/app.toml} slug=${slug##*/}
    mkdir -p "$WPX_DIR/apps/$slug"
    { grep -E '^(name|full_name|executable|description|wm_class_hint|start_menu_folder) = ' "$f"
      printf 'mime_types = ["%s"]\n' "${mimes//;/\", \"}"; } >"$WPX_DIR/apps/$slug/app.toml"
    winpodx app install "$slug" >/dev/null
    for m in ${mimes//;/ }; do
      has_default "$m" || xdg-mime default "winpodx-$slug.desktop" "$m"
    done
    printf '%s=%s\n' "${exe%.EXE}" "$slug" >>"$OFFICE_DIR/apps"
  done <<<"$OFFICE_TYPES"
  [[ -s $OFFICE_DIR/apps ]] || die "Office is installed, but WinPodX did not find Word, Excel or PowerPoint. Run 'winpodx app refresh', then 'kriss winapps office' again."
}

# kriss winapps office [--business] [--yes]: install Word, Excel and PowerPoint in Windows.
cmd_winapps_office() {
  ((EUID != 0)) || die "run 'kriss winapps office' as yourself, not root: WinPodX runs as your user."
  local a yes=0 product=O365HomePremRetail
  for a; do
    case "$a" in
      --yes) yes=1 ;;
      --business) product=O365BusinessRetail ;;
      *) die "unknown option '$a'. Use --business or --yes." ;;
    esac
  done
  command -v winpodx >/dev/null || die "WinPodX is not installed. Run 'kriss winapps setup' first."
  cat <<'EOF'
Microsoft Office (Word, Excel, PowerPoint) in WinPodX's Windows

  download  about 3 GB, straight from Microsoft. KrissOS includes no Office files.
  internet  needed for the whole install, and now and then for Office to stay activated.
  licence   your own. Sign in with your Microsoft 365 account when Word first opens, or
            choose to enter a product key there. Got a key on a card? Redeem it at
            https://www.microsoft.com/microsoft-365/setup first.
EOF
  if ((!yes)); then
    read -rp "Install Microsoft Office now? [y/N] " a || a=n
    [[ $a == [yY]* ]] || return 0
  fi
  # FreeRDP shows Windows apps as X windows (XWayland on the desktop); an ssh shell has none.
  [[ -n ${DISPLAY:-} ]] ||
    die "run this from a terminal on the desktop: Office setup opens a window, and this shell has no display (DISPLAY is not set)."
  curl -fsSI -m 10 "$OFFICE_ODT" >/dev/null 2>&1 ||
    die "Microsoft's download server cannot be reached. Connect to the internet and try again."
  winpodx pod start --wait >/dev/null 2>&1 ||
    die "Windows did not start. Run 'kriss winapps setup' first, or 'winpodx doctor' to see why."
  mkdir -p "$OFFICE_DIR" "$WPX_APPS/kriss-office-setup"
  rm -f "$OFFICE_DIR/installed"
  # Word, Excel and PowerPoint only. AcceptEULA stays off: Office asks the user to accept
  # Microsoft's licence terms itself.
  cat >"$OFFICE_DIR/configuration.xml" <<EOF
<Configuration>
  <Add OfficeClientEdition="64" Channel="Current">
    <Product ID="$product">
      <Language ID="MatchOS" />
      <ExcludeApp ID="Access" /><ExcludeApp ID="Groove" /><ExcludeApp ID="Lync" />
      <ExcludeApp ID="OneDrive" /><ExcludeApp ID="OneNote" /><ExcludeApp ID="Outlook" />
      <ExcludeApp ID="OutlookForWindows" /><ExcludeApp ID="Publisher" /><ExcludeApp ID="Teams" />
      <ExcludeApp ID="Bing" />
    </Product>
  </Add>
  <Display Level="Full" AcceptEULA="FALSE" />
  <Updates Enabled="TRUE" />
</Configuration>
EOF
  cat >"$OFFICE_DIR/install.ps1" <<EOF
# KrissOS: download Microsoft's Office Deployment Tool from Microsoft and install Office.
\$ErrorActionPreference = 'Stop'; \$ProgressPreference = 'SilentlyContinue'
\$Host.UI.RawUI.WindowTitle = 'Microsoft Office setup'
\$here = Split-Path -Parent \$MyInvocation.MyCommand.Path
\$odt = Join-Path \$env:TEMP 'kriss-office-setup.exe'
\$cfg = Join-Path \$env:TEMP 'kriss-office.xml'
try {
  Write-Host 'Downloading the Office installer from Microsoft...'
  Invoke-WebRequest -UseBasicParsing '$OFFICE_ODT' -OutFile \$odt
  \$sig = Get-AuthenticodeSignature \$odt
  if (\$sig.Status -ne 'Valid' -or \$sig.SignerCertificate.Subject -notmatch 'O=Microsoft Corporation') {
    throw 'The downloaded installer is not signed by Microsoft, so it was not run.'
  }
  Copy-Item (Join-Path \$here 'configuration.xml') \$cfg -Force
  Write-Host 'Installing Word, Excel and PowerPoint. Office shows its own progress; this takes a while.'
  \$p = Start-Process \$odt -ArgumentList '/configure', "\`"\$cfg\`"" -Verb RunAs -Wait -PassThru
  if (\$p.ExitCode -ne 0) { throw "Office setup stopped with code \$(\$p.ExitCode)." }
  Set-Content (Join-Path \$here 'installed') 'ok'
} catch {
  Write-Host \$_
  Read-Host 'Office was not installed. Press Enter to close'
  exit 1
}
EOF
  # The installer as a WinPodX app of our own; WinPodX shares the home folder with Windows
  # as \\tsclient\home once the session is up, so the script waits for it (WinPodX's own
  # file opens poll the same way). No commas: FreeRDP splits its /app value on them.
  # Not installed into Start, and removed again below.
  cat >"$WPX_APPS/kriss-office-setup/app.toml" <<'EOF'
name = "kriss-office-setup"
full_name = "Microsoft Office setup"
executable = 'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe'
args = '''-NoProfile -ExecutionPolicy Bypass -Command "$f = '\\tsclient\home\.local\share\kriss\office\install.ps1'; for ($i = 0; $i -lt 60 -and -not (Test-Path $f); $i++) { Start-Sleep 1 }; & $f"'''
EOF
  printf 'kriss: Office setup is running in Windows. Leave this open until it finishes.\n'
  winpodx app run kriss-office-setup --wait || true
  rm -r "$WPX_APPS/kriss-office-setup"
  [[ -f $OFFICE_DIR/installed ]] || die "Office was not installed. Run 'kriss winapps office' to try again."
  # WinPodX finds Word, Excel and PowerPoint and gives each a Start entry and its file types.
  winpodx app refresh || die "Office is installed, but WinPodX could not list it. Run 'winpodx app refresh'."
  office_types
  wpx_icons
  printf 'kriss: done. Word, Excel and PowerPoint are in Start. Sign in or enter your key when Word first opens.\n'
}

cmd_winapps() {
  # x86 Windows in a KVM VM; ARCHITECTURE §13 leaves it off Apple Silicon.
  [[ $(uname -m) == x86_64 ]] || die "Windows apps through WinPodX need an x86_64 PC; this is $(uname -m)."
  case "${1:-check}" in
    check) winapps_check ;;
    setup) cmd_winapps_setup ;;
    office) cmd_winapps_office "${@:2}" ;;
    *) die "unknown winapps command '$1'. Use check, setup or office." ;;
  esac
}

# --- kriss search, install, remove: software from every source, safest first ---------------
# The repos (KrissOS, then Arch), then Flathub, then the AUR (ARCHITECTURE §14). AUR packages
# are built with makepkg as the user who ran kriss, never as root, and only after that user has
# read the build script or what changed in it. snap-pac snapshots before every pacman run.
AUR_URL=${KRISS_AUR_URL:-https://aur.archlinux.org}
PKG_CACHE=${KRISS_PKG_CACHE:-/var/cache/pacman/pkg}

YES=0 # --yes: the Store has asked already (it runs kriss through pkexec, with no terminal)
ask() { # ask PROMPT y|n: the answer, or the default on an empty line; no at end of input
  local a
  ((YES == 0)) || return 0
  read -rp "$1 " a || return 1
  [[ ${a:-$2} == [yY]* ]]
}
has_snapper() { command -v snapper >/dev/null && snapper list-configs 2>/dev/null | grep -q '^root '; }
uri() { jq -rn --arg s "$1" '$s|@uri'; }
aur_get() { curl -fsSg --max-time 15 "$AUR_URL/rpc/v5/$1"; }
# aur_info NAME...: one JSON object per name the AUR has, a line each; fails offline.
# ponytail: one request for every name; split it if a PC ever has hundreds of AUR packages.
aur_info() {
  local q="" n
  for n; do q+="&arg[]=$(uri "$n")"; done
  aur_get "info?${q#&}" | jq -c '.results[]'
}

# fp_pick NAME < "id<TAB>name" rows: the first id, or the id's last part, or name, that is NAME.
fp_pick() {
  awk -F'\t' -v q="${1,,}" '{ id = tolower($1); n = split(id, p, ".")
    if (id == q || p[n] == q || tolower($2) == q) { print $1; f = 1; exit } } END { exit !f }'
}
flatpak_find() { command -v flatpak >/dev/null && flatpak search --columns=application,name -- "$1" 2>/dev/null | fp_pick "$1"; }
flatpak_installed() { command -v flatpak >/dev/null && flatpak list --app --columns=application,name 2>/dev/null | fp_pick "$1"; }

cmd_search() {
  (($#)) || die "search for what? Example: kriss search spotify"
  local repo aur fp=""
  # pacman -Ss: "repo/name version [installed]", then the description indented on the next line.
  repo=$(pacman -Ss -- "$@" 2>/dev/null | paste - - | awk -F'\t' '{ split($1, f, " "); split(f[1], rn, "/")
    d = $2; sub(/^ +/, "", d); print rn[1] "\t" rn[2] "\t" d ($1 ~ /\[installed/ ? "  (installed)" : "") }') || true
  if command -v flatpak >/dev/null; then
    fp=$(flatpak search --columns=application,name,description -- "$*" 2>/dev/null | awk -F'\t' 'NF >= 2 { print "flathub\t" $1 "\t" $2 ": " $3 }') || true
  fi
  aur=$(aur_get "search/$(uri "$*")?by=name-desc" | jq -r '.results | sort_by(-.Popularity)[]
    | ["aur", .Name, "\(.Description // "")  (\(.NumVotes) votes\(if .OutOfDate then ", out of date" else "" end)\(if .Maintainer == null then ", orphaned" else "" end))"] | @tsv') ||
    aur=offline
  section() { # section TITLE ROWS: ten at most, so the safe options stay on screen
    [[ -n $2 ]] || return 0
    printf '\n%s\n' "$1"
    awk -F'\t' 'NR <= 10 { printf "  %-30s %s\n", $2, $3 } END { if (NR > 10) printf "  ... and %d more\n", NR - 10 }' <<<"$2"
  }
  section 'KrissOS (made for KrissOS)' "$(awk -F'\t' '$1 == "kriss"' <<<"$repo")"
  section 'Arch (official, tested)' "$(awk -F'\t' 'NF && $1 != "kriss"' <<<"$repo")"
  section 'Flathub (app store, sandboxed)' "$fp"
  if [[ $aur == offline ]]; then
    printf '\nAUR: not searched. It cannot be reached (no internet?).\n'
  else
    section 'AUR (community scripts, built on this PC: kriss shows you the script first)' "$aur"
  fi
  [[ -n $repo$fp || ($aur != offline && -n $aur) ]] || { echo "Nothing found for '$*'."; return 1; }
  printf '\nInstall one with: kriss install NAME\n'
}

# The user who ran kriss through sudo or pkexec. AUR builds run as them, never as root.
BUILDER="" AUR_DIR=""
find_builder() {
  local u=${SUDO_USER:-}
  [[ -n $u || -z ${PKEXEC_UID:-} ]] || u=$(id -nu "$PKEXEC_UID")
  [[ -n $u && $u != root ]] || return 1
  BUILDER=$u
  AUR_DIR=${KRISS_AUR_DIR:-$(getent passwd "$u" | cut -d: -f6)/.cache/kriss/aur}
}
as_user() { runuser -u "$BUILDER" -- "$@"; }

declare -A AUR_JSON=() AUR_SEEN=() AUR_REVIEWED=()
AUR_ORDER=() AUR_REPO_DEPS=() AUR_MAKE_ONLY=()
aur_lookup() { # aur_lookup NAME: 0 found, 1 not in the AUR, 2 AUR unreachable
  [[ -z ${AUR_JSON[$1]:-} ]] || return 0
  local j
  j=$(aur_info "$1") || return 2
  [[ -n $j ]] || return 1
  AUR_JSON[$1]=$j
}

# aur_resolve NAME: NAME's AUR dependencies, then NAME, onto AUR_ORDER (the build order);
# the repo packages they need onto AUR_REPO_DEPS. pacman itself answers "is it installed"
# and "does a repo have it" (-T and -Sp), versions and provides included.
# ponytail: an AUR dependency is looked up by name only, not by what AUR packages provide.
aur_resolve() {
  local name=$1 make dep
  [[ -z ${AUR_SEEN[$name]:-} ]] || return 0
  AUR_SEEN[$name]=1
  aur_lookup "$name" || die "'$name' is not in the AUR, or it cannot be reached."
  while IFS=$'\t' read -r make dep; do
    pacman -T -- "$dep" >/dev/null && continue
    if pacman -Sp --print-format %n -- "$dep" >/dev/null 2>&1; then
      [[ " ${AUR_REPO_DEPS[*]} " == *" $dep "* ]] || AUR_REPO_DEPS+=("$dep")
      [[ $make == 0 ]] || AUR_MAKE_ONLY+=("${dep%%[<>=]*}")
    else
      aur_lookup "${dep%%[<>=]*}" || die "$name needs '$dep', which no repo or AUR package has."
      aur_resolve "${dep%%[<>=]*}"
    fi
  done < <(jq -r '(.Depends // [])[] | "0\t" + .' <<<"${AUR_JSON[$name]}"
    jq -r '((.MakeDepends // []) + (.CheckDepends // []))[] | "1\t" + .' <<<"${AUR_JSON[$name]}")
  AUR_ORDER+=("$name")
}

aur_warn() { # plain-words warnings about an AUR entry, one per line
  jq -r '(if .OutOfDate then "out of date: flagged on \(.OutOfDate | strftime("%Y-%m-%d")), so it may not build" else empty end),
    (if .Maintainer == null then "orphaned: nobody looks after it, so fixes may never come" else empty end),
    (if .NumVotes < 10 then "few users: \(.NumVotes) votes on the AUR" else empty end)' <<<"${AUR_JSON[$1]}"
}
aur_base() { jq -r .PackageBase <<<"${AUR_JSON[$1]}"; }

# aur_review NAME: fetch NAME's build files as the builder and show them: everything the
# first time, what changed since the last build after that. Fails unless the user says yes.
aur_review() {
  local name=$1 base dir last f
  base=$(aur_base "$name") dir=$AUR_DIR/$(aur_base "$name")
  [[ -z ${AUR_REVIEWED[$base]:-} ]] || return 0
  if [[ -d $dir/.git ]]; then
    as_user git -C "$dir" fetch -q origin || die "cannot download $name's build files (no internet?)."
  else
    as_user mkdir -p "$AUR_DIR"
    as_user git clone -q "$AUR_URL/$base.git" "$dir" || die "cannot download $name's build files (no internet?)."
  fi
  last=$(cat "$dir/.git/kriss-built" 2>/dev/null || true)
  printf '\n=== %s: the build script, from the AUR ===\n' "$name"
  if [[ -n $last ]]; then
    if [[ -z $(as_user git -C "$dir" diff "$last" origin/HEAD) ]]; then
      echo "No changes since you last built it."
      AUR_REVIEWED[$base]=1
      as_user git -C "$dir" reset -q --hard origin/HEAD
      return 0
    fi
    echo "What changed since you last built it:"
    as_user git -C "$dir" --no-pager diff "$last" origin/HEAD
  else
    # PKGBUILD runs as you to build; .install scripts run as root when pacman installs it.
    for f in $(as_user git -C "$dir" ls-tree --name-only origin/HEAD); do
      case $f in
        PKGBUILD | *.install) printf -- '--- %s\n' "$f"; as_user git -C "$dir" --no-pager show "origin/HEAD:$f" ;;
        .SRCINFO | .gitignore | .nvchecker.toml) ;;
        *) printf -- '--- %s (also in the package)\n' "$f" ;;
      esac
    done
  fi
  printf '\nThis script is written by the AUR community, not checked by Arch or KrissOS.\n'
  ask "Build $name with it? [y/N]" n || return 1
  as_user git -C "$dir" reset -q --hard origin/HEAD
  AUR_REVIEWED[$base]=1
}

# aur_build NAME AS_DEP: build NAME as the builder and install it. The commit it was built
# from is kept, so the next update shows only what changed.
aur_build() {
  local name=$1 dir key pkgs
  dir=$AUR_DIR/$(aur_base "$name")
  # makepkg checks signed sources against these keys; it cannot fetch them itself.
  while read -r key <&3; do
    as_user gpg --list-keys "$key" >/dev/null 2>&1 && continue
    ask "$name's sources are signed by key $key. Get that key from keyserver.ubuntu.com? [Y/n]" y ||
      die "stopped: makepkg cannot check $name's sources without the key."
    as_user gpg --keyserver hkps://keyserver.ubuntu.com --recv-keys "$key"
  done 3< <(sed -n 's/^\s*validpgpkeys = //p' "$dir/.SRCINFO" 2>/dev/null)
  printf '\nkriss: building %s as %s...\n' "$name" "$BUILDER"
  as_user env -C "$dir" makepkg -cf --noconfirm || die "building $name failed (see above). Nothing after it was installed."
  mapfile -t pkgs < <(as_user env -C "$dir" makepkg --packagelist | grep -E "/$name-[^-/]+-[^-/]+-[^-/]+\.pkg\.tar")
  ((${#pkgs[@]})) || die "makepkg built no package called $name."
  # --asdeps only for a dependency that is new: pacman keeps the reason of one it upgrades.
  if [[ $2 == 1 ]] && ! pacman -Q -- "$name" >/dev/null 2>&1; then
    pacman -U --noconfirm --asdeps -- "${pkgs[@]}"
  else
    pacman -U --noconfirm -- "${pkgs[@]}"
  fi
  as_user git -C "$dir" rev-parse HEAD | as_user tee "$dir/.git/kriss-built" >/dev/null
}

# aur_run NAME...: review then build and install NAME... and the AUR packages they need,
# after AUR_REPO_DEPS. Every review comes before the first change, so a no changes nothing.
aur_run() {
  local n orphans
  for n in "${AUR_ORDER[@]}"; do
    aur_review "$n" || { echo "kriss: stopped before building $n. Nothing was changed."; exit 1; }
  done
  ((${#AUR_REPO_DEPS[@]} == 0)) || pacman -S --needed --noconfirm --asdeps -- "${AUR_REPO_DEPS[@]}"
  for n in "${AUR_ORDER[@]}"; do
    if [[ " $* " == *" $n "* ]]; then aur_build "$n" 0; else aur_build "$n" 1; fi
  done
  # Build-only tools go again, unless something else now needs them.
  if ((${#AUR_MAKE_ONLY[@]})); then
    mapfile -t orphans < <(pacman -Qdtq | grep -xF -f <(printf '%s\n' "${AUR_MAKE_ONLY[@]}") || true)
    ((${#orphans[@]} == 0)) || pacman -Rns --noconfirm -- "${orphans[@]}"
  fi
}

human() { numfmt --to=iec-i --suffix=B "$1"; }

cmd_install() {
  local only="" n id rc
  while [[ ${1:-} == --* ]]; do
    case $1 in
      --repo | --flatpak | --aur) only=$1 ;;
      --yes) YES=1 ;;
      *) die "unknown option '$1'. Use --repo, --flatpak, --aur or --yes." ;;
    esac
    shift
  done
  (($#)) || die "install what? Example: kriss install spotify. Find names with: kriss search WORDS"
  ((EUID == 0)) || exec sudo "$0" install ${only:+"$only"} "$@"
  local repo=() flat=() aur=()
  for n; do
    if [[ $only != --flatpak && $only != --aur ]] && pacman -Si -- "$n" >/dev/null 2>&1; then repo+=("$n")
    elif [[ $only != --repo && $only != --aur ]] && id=$(flatpak_find "$n"); then flat+=("$id")
    elif [[ $only != --repo && $only != --flatpak ]] && { aur_lookup "$n"; rc=$?; ((rc == 0)); }; then aur+=("$n")
    elif [[ ${rc:-} == 2 ]]; then
      die "'$n' is not in the KrissOS or Arch repos or on Flathub, and the AUR cannot be reached (no internet?)."
    else
      die "'$n' was not found. Look for its name with: kriss search $n"
    fi
    rc=""
  done

  ((${#aur[@]} == 0 || YES == 0)) ||
    die "AUR packages need someone to read their build script first. Run 'kriss install ${aur[*]}' in a terminal."
  if ((${#aur[@]})); then
    find_builder || die "AUR packages are built as you, never as root. Run 'kriss install' from your own account, not a root login."
    pacman -T base-devel >/dev/null || AUR_REPO_DEPS+=(base-devel)
    for n in "${aur[@]}"; do aur_resolve "$n"; done
  fi

  # The plan: what, from where, how big, and how to undo it.
  local rows="" f r s l total=0 extra=0 missing=() want=()
  want=("${repo[@]}" "${AUR_REPO_DEPS[@]}")
  if ((${#want[@]})); then
    rows=$(pacman -Sp --needed --print-format $'%n\t%r\t%s\t%l\t%f' -- "${want[@]}") ||
      die "pacman cannot work out what ${want[*]} needs (see above)."
  fi
  echo "kriss will install:"
  for n in "${repo[@]}"; do
    r=$(awk -F'\t' -v n="$n" '$1 == n { print $2 }' <<<"$rows")
    case $r in
      "") printf '  %-28s already installed\n' "$n" ;;
      kriss) printf '  %-28s from KrissOS\n' "$n" ;;
      *) printf '  %-28s from Arch (official)\n' "$n" ;;
    esac
  done
  for n in "${flat[@]}"; do
    s=$(flatpak remote-info flathub "$n" 2>/dev/null | sed -n 's/^ *Installed: *//p' || true)
    printf '  %-28s from Flathub (sandboxed app)%s\n' "$n" "${s:+, $s}"
  done
  for n in "${AUR_ORDER[@]}"; do
    if [[ " ${aur[*]} " == *" $n "* ]]; then
      printf '  %-28s from the AUR (community script, built on this PC)\n' "$n"
    else
      printf '  %-28s from the AUR, needed by the above\n' "$n"
    fi
    aur_warn "$n" | sed 's/^/      ! /'
  done
  while IFS=$'\t' read -r n r s l f; do
    [[ -n $n ]] || continue
    total=$((total + s))
    [[ " ${repo[*]} " == *" $n "* ]] || extra=$((extra + 1))
    [[ -e $PKG_CACHE/$f ]] || missing+=("$l")
  done <<<"$rows"
  ((extra == 0)) || printf '  plus %d packages they need from the repos\n' "$extra"
  ((total == 0)) || printf 'Download: %s\n' "$(human "$total")"
  if ((${#missing[@]})) && ! curl -fsIo /dev/null --max-time 5 "${missing[0]}"; then
    die "this PC is offline, and ${#missing[@]} of these packages are not downloaded yet. Connect to the internet and try again. Nothing was changed."
  fi
  ! has_snapper || echo "A snapshot is taken first."
  echo "To undo: kriss remove $*, or kriss rollback from the boot menu's KrissOS > Snapshots."
  ask "Go ahead? [Y/n]" y || return 1

  # snap-pac snapshots pacman runs; Flatpak apps live on the root subvolume too, so snapshot them.
  ((${#flat[@]} == 0)) || snapshot "before kriss install ${flat[*]}"
  if ((${#repo[@]})); then
    pacman -S --needed --noconfirm -- "${repo[@]}" || die "installing ${repo[*]} failed (see above)."
  fi
  if ((${#flat[@]})); then
    flatpak install --noninteractive flathub "${flat[@]}" || die "installing ${flat[*]} from Flathub failed (see above)."
  fi
  ((${#aur[@]} == 0)) || aur_run "${aur[@]}"
  echo "kriss: done. Installed: $*"
}

cmd_remove() {
  [[ ${1:-} != --yes ]] || { YES=1; shift; }
  (($#)) || die "remove what? Example: kriss remove spotify"
  ((EUID == 0)) || exec sudo "$0" remove "$@"
  local n id pac=() flat=() also
  for n; do
    if pacman -Q -- "$n" >/dev/null 2>&1; then pac+=("$n")
    elif id=$(flatpak_installed "$n"); then flat+=("$id")
    else die "'$n' is not installed. List what is with: pacman -Qe, and flatpak list --app"; fi
  done
  echo "kriss will remove: ${pac[*]} ${flat[*]}"
  if ((${#pac[@]})); then
    also=$(pacman -Rnsp --print-format %n -- "${pac[@]}" | grep -vxF -f <(printf '%s\n' "${pac[@]}") | paste -sd' ' || true)
    [[ -z $also ]] || echo "  and what only they needed: $also"
  fi
  ! has_snapper || echo "A snapshot is taken first."
  echo "To undo: kriss install $*, or kriss rollback from the boot menu's KrissOS > Snapshots."
  ask "Go ahead? [Y/n]" y || return 1
  ((${#flat[@]} == 0)) || snapshot "before kriss remove ${flat[*]}"
  ((${#pac[@]} == 0)) || pacman -Rns --noconfirm -- "${pac[@]}"
  ((${#flat[@]} == 0)) || flatpak uninstall --noninteractive -- "${flat[@]}"
  echo "kriss: done. Removed: $*"
}

# kriss update's AUR part: packages pacman has from no repo (pacman -Qm) that the AUR has a
# newer version of. Needs someone to read the changes, so the update notice skips it.
aur_update() {
  local name ver new j info up=() gone=()
  declare -A have=()
  while read -r name ver; do have[$name]=$ver; done < <(pacman -Qm)
  ((${#have[@]})) || return 0
  info=$(aur_info "${!have[@]}") || { echo "kriss: the AUR cannot be reached, so AUR packages were not checked."; return 0; }
  while read -r j; do
    [[ -n $j ]] || continue
    AUR_JSON[$(jq -r .Name <<<"$j")]=$j
  done <<<"$info"
  for name in "${!have[@]}"; do
    if [[ -z ${AUR_JSON[$name]:-} ]]; then gone+=("$name"); continue; fi
    new=$(jq -r .Version <<<"${AUR_JSON[$name]}")
    (($(vercmp "$new" "${have[$name]}") > 0)) || continue
    up+=("$name")
    printf '  %-28s %s -> %s\n' "$name" "${have[$name]}" "$new"
    aur_warn "$name" | sed 's/^/      ! /'
  done
  ((${#gone[@]} == 0)) || echo "kriss: not in the AUR any more, so kept as they are: ${gone[*]}"
  ((${#up[@]})) || { echo "kriss: AUR packages are up to date."; return 0; }
  if [[ ! -t 0 ]]; then
    echo "kriss: ${#up[@]} AUR packages have updates. Read their changes first: run 'kriss update' in a terminal."
    return 0
  fi
  find_builder || { echo "kriss: AUR packages are built as you, never as root. Run 'kriss update' from your own account."; return 0; }
  for name in "${up[@]}"; do aur_resolve "$name"; done
  aur_run "${up[@]}"
}

cmd_version() {
  printf 'kriss %s\n%s\n' "$KRISS_VERSION" "$(os_field PRETTY_NAME 'not running on KrissOS')"
}

cmd_kapcai() {
  cat <<'EOF'

                 __
            ____/ _\___
      _____/___________\___
     (  @  )           (  @  )
      `---'             `---'
EOF
  printf '   Modenas Kriss 110 · %s\n\n' "$(os_field PRETTY_NAME KrissOS)"
}

cmd_help() {
  cat <<'EOF'
Usage: kriss [command]

Commands:
  info       Show a summary of this system (default)
  search WORDS    Find apps in KrissOS, Arch, Flathub and the AUR, safest first
  install NAME    Install from the safest place that has it (--repo, --flatpak, --aur to pick;
                  --yes skips the question)
  remove NAME     Remove a package or Flatpak app, and what only it needed
  update     Update everything, AUR packages included, after a snapshot
  version    Show the kriss and KrissOS versions
  hwcheck    Print hardware facts (RAM, CPU, GPU, VM support) as JSON
  rollback   Keep the snapshot booted from the boot menu as your system
  reset --keep-files   Reset this PC: remove added apps and reset settings, keep your files
  reset --everything   Reset this PC: also delete every file in /home and saved Wi-Fi
             Both show the plan and ask you to type RESET, take a snapshot, then finish at
             the next restart. --dry-run only shows the plan, --yes skips the question,
             --cancel stops a waiting reset. Exit: 0 done or waiting, 1 not confirmed, 2 error.
  report [TITLE]  Report a problem: shows what will be sent (names, Wi-Fi, serials taken out),
             asks, then opens a GitHub issue to submit, or saves a file when offline.
             --print only prints it, --open skips the question, --save FILE writes it.
             Exit: 0 opened or saved, 1 not confirmed, 2 error, 3 offline (saved to a file)
  channel    Show which update channel this PC is on (stable or testing)
  channel testing   Get updates from [kriss-testing] before they reach everyone
  channel stable    Go back to [kriss] (downgrades what came from testing, after a snapshot)
  guest      Say whether the guest account is on
  guest on   Add a guest account: no password, not an admin, emptied at every sign-in (root)
  guest off  Remove it and what is in it (root)
  migrate    Turn this Arch or CachyOS install into KrissOS (try --dry-run first)
  winapps check   Check this PC is ready for Windows apps in WinPodX (read-only)
  winapps setup   Fix what is missing (asks first), then set up Windows with WinPodX
  winapps office  Install Microsoft Office in WinPodX, downloaded from Microsoft (your own
                  licence; --business for Microsoft 365 Business plans)
  nvidia check    Say whether this PC's NVIDIA GPU can use the NVIDIA 580 driver
  nvidia setup    Install that driver (root, needs internet); nouveau stays otherwise
  help       Show this help
EOF
}

# The guest account: "guest", no password, not an admin, shown on the login screen. The
# KrissOS Shell empties its home at every sign-in (kriss-shell), so nothing a guest does
# stays. The marker file says the account is ours; a "guest" someone made by hand is left alone.
readonly GUEST_MARK="${KRISS_GUEST_MARK:-/var/lib/kriss/guest}"
cmd_guest() {
  case "${1:-status}" in
    status)
      if [[ -e $GUEST_MARK ]]; then echo on; else echo off; fi
      ;;
    on)
      ((EUID == 0)) || die "run 'pkexec kriss guest on': it adds an account."
      [[ -e $GUEST_MARK ]] && { echo "The guest account is already on."; return 0; }
      id guest &>/dev/null && die "there is already an account called guest that KrissOS did not make; it is left alone."
      useradd --create-home --comment "Guest" --shell /bin/bash guest
      passwd --delete guest >/dev/null
      mkdir -p "${GUEST_MARK%/*}" && : >"$GUEST_MARK"
      echo "The guest account is on. Pick Guest on the login screen; it needs no password."
      ;;
    off)
      ((EUID == 0)) || die "run 'pkexec kriss guest off': it removes an account."
      [[ -e $GUEST_MARK ]] || { echo "The guest account is already off."; return 0; }
      loginctl terminate-user guest 2>/dev/null || true
      userdel --remove guest 2>/dev/null || true
      rm -f "$GUEST_MARK"
      echo "The guest account is off, and what was in it is gone."
      ;;
    *) die "usage: kriss guest [status|on|off]" ;;
  esac
}

main() {
  case "${1:-info}" in
    info) cmd_info ;;
    update) cmd_update ;;
    search) cmd_search "${@:2}" ;;
    install) cmd_install "${@:2}" ;;
    remove) cmd_remove "${@:2}" ;;
    version | --version | -V) cmd_version ;;
    hwcheck) cmd_hwcheck ;;
    tune) cmd_tune "${@:2}" ;;
    winapps) cmd_winapps "${@:2}" ;;
    nvidia) cmd_nvidia "${@:2}" ;;
    rollback) cmd_rollback "${@:2}" ;;
    reset) cmd_reset "${@:2}" ;;
    report) cmd_report "${@:2}" ;;
    channel) cmd_channel "${@:2}" ;;
    guest) cmd_guest "${@:2}" ;;
    migrate) exec kriss-migrate "${@:2}" ;;
    help | --help | -h) cmd_help ;;
    --kapcai) cmd_kapcai ;;
    *) die "unknown command '$1'. Run 'kriss help'." ;;
  esac
}

# Sourced by tests (tools/ci/nvidia-test.sh), run otherwise.
[[ ${BASH_SOURCE[0]} != "$0" ]] || main "$@"
